    detail: 'Atendimento rápido via WhatsApp'
  }
];

const FAQ_ITEMS = [
  {
    question: 'Como funciona a Placa NFC Google?',
    answer:
      'A Placa NFC Google possui um chip NFC interno integrado e um QR Code impresso. Quando o cliente aproxima o smartphone da placa ou escaneia o QR Code com a câmera, a página oficial de avaliação da sua empresa no Google abre diretamente no celular, facilitando o envio da avaliação. O link de destino pode ser gerenciado na plataforma conforme as funcionalidades existentes.'
  },
  {
    question: 'O que posso editar no Bio Site?',
    answer:
      'Ao adquirir o Bio Site + Cartão NFC, você recebe usuário e senha para acessar o seu portal exclusivo. Nele, é possível personalizar exclusivamente seis itens: a cor do Bio Site, o logotipo, a imagem principal, até quatro imagens de produtos, o link do Instagram e o link do WhatsApp.'
  },
  {
    question: 'Posso alterar a estrutura do modelo?',
    answer:
      'Não. A estrutura, a disposição das seções e os demais elementos de cada modelo de Bio Site são padronizados para assegurar estabilidade visual, carregamento rápido e correta exibição em qualquer smartphone. Caso sua empresa necessite de uma arquitetura sob medida, recomendamos a Estrutura Digital Completa (sob consulta).'
  },
  {
    question: 'O cartão NFC acompanha o Bio Site?',
    answer:
      'Sim. O pacote Bio Site + Cartão NFC (R$ 1.199,00) inclui tanto o seu Bio Site profissional configurado no modelo escolhido quanto o cartão físico com tecnologia NFC e QR Code vinculado ao seu endereço digital.'
  },
  {
    question: 'Como funciona o projeto sob consulta?',
    answer:
      'A Estrutura Digital Completa é voltada para empresas que necessitam de criação de site institucional próprio, estrutura digital mais complexa e gerenciamento do Perfil da Empresa no Google. O escopo técnico e a proposta comercial são definidos de forma personalizada após alinhamento com nossa equipe.'
  }
];

const PORTAL_PREVIEW_COLORS = [
  { name: 'Ciano Tecnológico', hex: '#00B8D9' },
  { name: 'Azul Executivo', hex: '#2563EB' },
  { name: 'Esmeralda Clínica', hex: '#059669' },
  { name: 'Âmbar Gourmet', hex: '#D97706' }
];

export const SalesLandingPage: React.FC<SalesLandingPageProps> = ({
  onOpenLogin,
  onExploreDemo,
  initialNiche,
  onRegisterInterest,
  isAdminAuthenticated,
  onGoToAdminPanel
}) => {
  const [selectedShowcaseMockupId, setSelectedShowcaseMockupId] = useState<string>(() => {
    if (initialNiche) {
      const matched = READY_MINISITE_MOCKUPS.find(
        (m) =>
          SHOWCASE_PUBLIC_MODEL_IDS.includes(m.id) &&
          (m.id.toLowerCase().includes(initialNiche.toLowerCase()) ||
            m.category.toLowerCase().includes(initialNiche.toLowerCase()))
      );
      if (matched) return matched.id;
    }
    return 'bio_medica';
  });

  const [segmentFilter, setSegmentFilter] = useState<'all' | 'saude' | 'executivo' | 'gastronomia'>('all');
  const [fullscreenEmulationMockup, setFullscreenEmulationMockup] = useState<ReadyMockupTemplate | null>(null);
  const [isHeaderScrolled, setIsHeaderScrolled] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isNfcTapSimulating, setIsNfcTapSimulating] = useState(false);
  const [isPrivacyModalOpen, setIsPrivacyModalOpen] = useState(false);
  const [isDemoModalOpen, setIsDemoModalOpen] = useState(false);
  const [demoModalFilter, setDemoModalFilter] = useState<'all' | 'minisite' | 'nfc' | 'cardapio' | 'card'>('all');
  const [openFaqIndex, setOpenFaqIndex] = useState<number | null>(0);
  const [portalPreviewAccent, setPortalPreviewAccent] = useState<string>('#00B8D9');

  // Public Interest Capture Modal State (preserves anti-bot honeypot & rate limiting)
  const [isInterestModalOpen, setIsInterestModalOpen] = useState(false);
  const [interestTopic, setInterestTopic] = useState<string>('Bio Site + Cartão NFC (R$ 1.199,00)');
  const [interestName, setInterestName] = useState('');
  const [interestEmail, setInterestEmail] = useState('');
  const [interestPhone, setInterestPhone] = useState('');
  const [interestCompany, setInterestCompany] = useState('');
  const [interestNicheInput, setInterestNicheInput] = useState('');
  const [honeypotWebsite, setHoneypotWebsite] = useState('');
  const [isSubmittingInterest, setIsSubmittingInterest] = useState(false);
  const [interestSubmittedSuccess, setInterestSubmittedSuccess] = useState(false);
  const [interestError, setInterestError] = useState('');
  const [lastSubmitTimestamp, setLastSubmitTimestamp] = useState<number>(0);

  // Secret 5-click footer logo ref for hidden Admin/Client Portal access
  const secretLogoClicksRef = useRef<{ count: number; lastClick: number }>({ count: 0, lastClick: 0 });

  const openInterestModal = (topic?: string) => {
    if (topic) setInterestTopic(topic);
    setInterestSubmittedSuccess(false);
    setInterestError('');
    setIsInterestModalOpen(true);
  };

  const handleSecretFooterLogoClick = () => {
    const now = Date.now();
    if (now - secretLogoClicksRef.current.lastClick > 2500) {
      secretLogoClicksRef.current.count = 1;
    } else {
      secretLogoClicksRef.current.count += 1;
    }
    secretLogoClicksRef.current.lastClick = now;
    if (secretLogoClicksRef.current.count >= 5) {
      secretLogoClicksRef.current.count = 0;
      onOpenLogin();
    }
  };

  const triggerLiveNfcTapSimulation = () => {
    setIsNfcTapSimulating(true);
    setTimeout(() => setIsNfcTapSimulating(false), 3200);
  };

  const handleInterestSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setInterestError('');

    // 1. Anti-bot Honeypot check
    if (honeypotWebsite.trim().length > 0) {
      setInterestSubmittedSuccess(true);
      return;
    }

    // 2. Rate limiting (cooldown of 30s between submissions)
    const now = Date.now();
    if (now - lastSubmitTimestamp < 30000) {
      setInterestError('Aguarde alguns segundos antes de enviar uma nova solicitação.');
      return;
    }

    const cleanName = interestName.trim();
    const cleanEmail = interestEmail.trim().toLowerCase();
    const cleanPhone = interestPhone.replace(/\D/g, '');
    const cleanCompany = interestCompany.trim() || cleanName;

    if (!cleanName || cleanName.length < 2) {
      setInterestError('Por favor, informe seu nome completo.');
      return;
    }
    if (!cleanEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      setInterestError('Por favor, informe um e-mail válido para contato.');
      return;
    }
    if (!cleanPhone || cleanPhone.length < 10) {
      setInterestError('Por favor, informe seu WhatsApp ou telefone com DDD.');
      return;
    }

    setIsSubmittingInterest(true);
    try {
      if (onRegisterInterest) {
        await onRegisterInterest({
          name: cleanName,
          email: cleanEmail,
          phone: cleanPhone,
          companyName: cleanCompany,
          niche: interestNicheInput.trim() || 'Não informado',
          interestType: interestTopic
        });
      }
      setLastSubmitTimestamp(Date.now());
      setInterestSubmittedSuccess(true);
    } catch (_) {
      setInterestSubmittedSuccess(true);
    } finally {
      setIsSubmittingInterest(false);
    }
  };

  const publicShowcaseModels: ReadyMockupTemplate[] = useMemo(() => {
    return SHOWCASE_PUBLIC_MODEL_IDS.map((id) =>
      READY_MINISITE_MOCKUPS.find((m) => m.id === id)
    ).filter((m): m is ReadyMockupTemplate => Boolean(m));
  }, []);

  const filteredShowcaseModels: ReadyMockupTemplate[] = useMemo(() => {
    if (segmentFilter === 'all') return publicShowcaseModels;
    return publicShowcaseModels.filter((m) => MODEL_SEGMENT_GROUP[m.id] === segmentFilter);
  }, [publicShowcaseModels, segmentFilter]);

  const selectedShowcaseMockup: ReadyMockupTemplate = useMemo(() => {
    return (
      publicShowcaseModels.find((m) => m.id === selectedShowcaseMockupId) ||
      publicShowcaseModels[0] ||
      READY_MINISITE_MOCKUPS[0]
    );
  }, [publicShowcaseModels, selectedShowcaseMockupId]);

  useEffect(() => {
    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      setIsHeaderScrolled(y > 20);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  return (
    <div className="alf-lp-root min-h-screen">
      {/* Authenticated Admin Return Bar (Only visible if admin is already logged in) */}
      {isAdminAuthenticated && onGoToAdminPanel && (
        <div className="bg-[#070B14] border-b border-white/10 py-2 px-4 text-xs text-slate-300">
          <div className="alf-lp-container flex items-center justify-between gap-4">
            <span className="flex items-center gap-2 font-medium">
              <span className="w-2 h-2 rounded-full bg-emerald-400" />
              Sessão administrativa ativa
            </span>
            <button
              type="button"
              onClick={onGoToAdminPanel}
              className="text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1 cursor-pointer transition"
            >
              <span>Voltar ao Console Administrativo</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      )}

      {/* ======================================================================
          SEÇÃO 1 — HEADER MINIMALISTA FIXO (72px)
         ====================================================================== */}
      <header className={`alf-lp-header ${isHeaderScrolled ? 'is-scrolled' : ''}`}>
        <div className="alf-lp-container h-full flex items-center justify-between gap-6">
          {/* Esquerda: Logotipo ALF Automação */}
          <a href="#" className="flex items-center gap-3 shrink-0 text-decoration-none">
            <div className="h-10 w-28 rounded-xl bg-black border border-white/10 overflow-hidden flex items-center justify-center p-1">
              <img
                src="/alf-logo.jpg"
                alt="ALF Automação"
                className="w-full h-full object-contain"
              />
            </div>
            <span className="hidden sm:inline-block font-semibold text-white text-sm tracking-tight">
              ALF Automação
            </span>
          </a>

          {/* Centro/Direita: Navegação Desktop */}
          <nav className="hidden lg:flex items-center gap-8 text-sm font-medium text-slate-300">
            <a href="#solucoes" className="hover:text-white transition-colors">
              Soluções
            </a>
            <a href="#modelos" className="hover:text-white transition-colors">
              Modelos
            </a>
            <a href="#como-funciona" className="hover:text-white transition-colors">
              Como funciona
            </a>
            <a href="#precos" className="hover:text-white transition-colors">
              Preços
            </a>
            <a href="#faq" className="hover:text-white transition-colors">
              FAQ
            </a>
          </nav>

          {/* Direita: Botão Primário + Gatilho Mobile */}
          <div className="flex items-center gap-3">
            <button
              type="button"
              onClick={() => openInterestModal('Solicitar proposta comercial')}
              className="alf-lp-btn-primary text-xs sm:text-sm !py-2.5 !px-4 sm:!px-5"
            >
              <span>Solicitar proposta</span>
              <ArrowRight className="w-4 h-4" />
            </button>

            <button
              type="button"
              onClick={() => setIsMobileMenuOpen((prev) => !prev)}
              className="lg:hidden w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center cursor-pointer transition"
              aria-label={isMobileMenuOpen ? 'Fechar menu de navegação' : 'Abrir menu de navegação'}
            >
              {isMobileMenuOpen ? <X className="w-5 h-5" /> : <Menu className="w-5 h-5" />}
            </button>
          </div>
        </div>

        {/* Menu Mobile Responsivo */}
        {isMobileMenuOpen && (
          <div className="lg:hidden bg-[#0B1220] border-b border-white/10 px-6 py-5 space-y-4 shadow-2xl">
            <nav className="flex flex-col space-y-3 text-sm font-medium text-slate-200">
              <a
                href="#solucoes"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-cyan-400 transition-colors"
              >
                Soluções
              </a>
              <a
                href="#modelos"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-cyan-400 transition-colors"
              >
                Modelos
              </a>
              <a
                href="#como-funciona"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-cyan-400 transition-colors"
              >
                Como funciona
              </a>
              <a
                href="#precos"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-cyan-400 transition-colors"
              >
                Preços
              </a>
              <a
                href="#faq"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-cyan-400 transition-colors"
              >
                FAQ
              </a>
            </nav>
            <div className="pt-3 border-t border-white/10 flex flex-col gap-2.5">
              <button
                type="button"
                onClick={() => {
                  setIsMobileMenuOpen(false);
                  openInterestModal('Solicitar proposta comercial');
                }}
                className="alf-lp-btn-primary w-full justify-center"
              >
                <span>Solicitar proposta</span>
                <ArrowRight className="w-4 h-4" />
              </button>
              <button
                type="button"
                onClick={() => {
                  setIsMobileMenuOpen(false);
                  setIsDemoModalOpen(true);
                }}
                className="alf-lp-btn-secondary-dark w-full justify-center"
              >
                <Play className="w-4 h-4" />
                <span>Central de demonstrações</span>
              </button>
            </div>
          </div>
        )}
      </header>

      {/* ======================================================================
          SEÇÃO 2 — HERO SECTION (DUAS COLUNAS: 7 ESQUERDA / 5 DIREITA)
         ====================================================================== */}
      <section className="alf-lp-section alf-lp-section-dark alf-lp-grid-pattern overflow-hidden">
        <div className="alf-lp-hero-glow absolute inset-0 pointer-events-none" />

        <div className="alf-lp-container relative z-10">
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
            {/* Coluna Esquerda (7 Colunas) */}
            <div className="lg:col-span-7 space-y-6 text-left">
              <div className="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/10">
                <span className="w-2 h-2 rounded-full bg-[#00B8D9]" />
                <span className="alf-lp-eyebrow text-slate-300">
                  ALF AUTOMAÇÃO • IDENTIDADE DIGITAL &amp; TECNOLOGIA NFC
                </span>
              </div>

              <h1 className="alf-lp-hero-title text-white">
                Presença digital profissional e conexão imediata com seus clientes.
              </h1>

              <p className="alf-lp-body-lg text-slate-300 max-w-2xl">
                Placas NFC para avaliação no Google, Bio Sites profissionais com cartão NFC e estruturas digitais sob medida para empresas que desejam transmitir autoridade.
              </p>

              <div className="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
                <a href="#solucoes" className="alf-lp-btn-primary">
                  <span>Conhecer soluções</span>
                  <ArrowRight className="w-4 h-4" />
                </a>

                <a href="#modelos" className="alf-lp-btn-secondary-dark">
                  <Eye className="w-4 h-4 text-[#00B8D9]" />
                  <span>Explorar modelos de Bio Site</span>
                </a>
              </div>

              {/* Resumo arquitetônico das 3 ofertas */}
              <div className="pt-6 border-t border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div className="bg-white/[0.02] border border-white/[0.07] rounded-xl p-3.5">
                  <span className="text-[11px] font-mono uppercase tracking-wider text-slate-400 block">
                    01. Placa NFC Google
                  </span>
                  <strong className="text-white text-sm font-semibold mt-0.5 block">
                    R$ 129,00
                  </strong>
                  <span className="text-xs text-slate-400 block mt-0.5">
                    Aproximação NFC e QR Code
                  </span>
                </div>

                <div className="bg-white/[0.04] border border-[#00B8D9]/30 rounded-xl p-3.5">
                  <span className="text-[11px] font-mono uppercase tracking-wider text-[#00B8D9] block">
                    02. Bio Site + Cartão NFC
                  </span>
                  <strong className="text-white text-sm font-semibold mt-0.5 block">
                    R$ 1.199,00
                  </strong>
                  <span className="text-xs text-slate-300 block mt-0.5">
                    Modelo pronto + Portal de edição
                  </span>
                </div>

                <div className="bg-white/[0.02] border border-white/[0.07] rounded-xl p-3.5">
                  <span className="text-[11px] font-mono uppercase tracking-wider text-slate-400 block">
                    03. Estrutura Digital
                  </span>
                  <strong className="text-white text-sm font-semibold mt-0.5 block">
                    Sob consulta
                  </strong>
                  <span className="text-xs text-slate-400 block mt-0.5">
                    Site + Perfil Google
                  </span>
                </div>
              </div>
            </div>

            {/* Coluna Direita (5 Colunas): Composição Visual Sofisticada */}
            <div className="lg:col-span-5">
              <div className="alf-lp-dark-panel p-6 sm:p-7 space-y-6 relative overflow-hidden">
                <div className="flex items-center justify-between border-b border-white/10 pb-4">
                  <div>
                    <span className="alf-lp-eyebrow text-[#00B8D9] block">
                      ECOSSISTEMA FÍSICO &amp; DIGITAL
                    </span>
                    <h2 className="text-base font-semibold text-white mt-0.5">
                      Hardware NFC + Identidade em Nuvem
                    </h2>
                  </div>
                  <button
                    type="button"
                    onClick={triggerLiveNfcTapSimulation}
                    className="text-xs font-medium px-3 py-1.5 rounded-lg bg-[#00B8D9]/15 text-[#00B8D9] border border-[#00B8D9]/30 hover:bg-[#00B8D9]/25 transition cursor-pointer flex items-center gap-1.5"
                  >
                    <Radio className="w-3.5 h-3.5" />
                    <span>{isNfcTapSimulating ? 'Sinal NFC ativo' : 'Testar sinal NFC'}</span>
                  </button>
                </div>

                {/* Composição: Placa NFC Google + Cartão NFC + Smartphone Bio Site */}
                <div className="grid grid-cols-1 sm:grid-cols-12 gap-4 items-stretch">
                  {/* Esquerda da Composição: Placa NFC Google + Cartão NFC */}
                  <div className="sm:col-span-6 flex flex-col justify-between gap-4">
                    {/* Item 1: Placa NFC Google */}
                    <div
                      onClick={triggerLiveNfcTapSimulation}
                      className="rounded-2xl bg-[#0B1220] border border-white/15 p-4 flex flex-col justify-between gap-3 cursor-pointer hover:border-[#00B8D9]/50 transition relative overflow-hidden"
                      title="Clique para simular aproximação NFC"
                    >
                      <div className="flex items-center justify-between">
                        <span className="text-[10px] font-mono uppercase tracking-wider text-slate-400">
                          PLACA NFC GOOGLE
                        </span>
                        <Wifi className="w-3.5 h-3.5 text-[#00B8D9] rotate-90" />
                      </div>

                      <div className="flex items-center gap-3 my-1">
                        <div className="w-10 h-10 rounded-xl bg-white p-2 flex items-center justify-center shrink-0 shadow">
                          <svg viewBox="0 0 24 24" className="w-full h-full">
                            <path
                              fill="#4285F4"
                              d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.665-5.17 3.665-9.12z"
                            />
                            <path
                              fill="#34A853"
                              d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.03c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.13C3.26 21.41 7.33 24 12 24z"
                            />
                            <path
                              fill="#FBBC05"
                              d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.58H1.24C.45 8.15 0 9.97 0 12s.45 3.85 1.24 5.42l4.04-3.13z"
                            />
                            <path
                              fill="#EA4335"
