              const isSelected = selectedShowcaseMockup.id === tmpl.id;
              return (
                <div
                  key={tmpl.id}
                  className={`alf-lp-card p-6 flex flex-col justify-between gap-6 text-left ${
                    isSelected ? 'ring-2 ring-[#00B8D9] border-transparent' : ''
                  }`}
                >
                  <div className="space-y-4">
                    {/* Preview Superior Elegante do Modelo */}
                    <div className="rounded-xl bg-[#0B1220] p-4 text-white relative overflow-hidden border border-[#172033]">
                      <div className="flex items-center justify-between gap-2 mb-3">
                        <span className="text-[11px] font-mono uppercase tracking-wider text-[#00B8D9] bg-[#00B8D9]/10 px-2.5 py-0.5 rounded-full border border-[#00B8D9]/30">
                          {tmpl.category}
                        </span>
                        <span className="text-lg" aria-hidden="true">
                          {tmpl.emoji}
                        </span>
                      </div>

                      <div className="flex items-center gap-3">
                        {tmpl.config.logoUrl ? (
