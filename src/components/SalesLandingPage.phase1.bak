  },
  {
    number: '05',
    title: 'Link do Instagram',
    description: 'Conecte o endereço oficial do seu perfil no Instagram para acesso imediato dos visitantes.',
    icon: Instagram,
    detail: 'Redirecionamento direto'
  },
  {
    number: '06',
    title: 'Link do WhatsApp',
    description: 'Configure o número oficial de atendimento comercial para contato com um toque.',
