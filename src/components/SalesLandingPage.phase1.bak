    detail: 'Upload direto de imagem'
  },
  {
    number: '03',
    title: 'Imagem principal',
    description: 'Atualize a foto de perfil profissional ou imagem de capa principal do seu Bio Site.',
    icon: Camera,
    detail: 'Destaque visual de abertura'
  },
  {
    number: '04',
    title: 'Até quatro imagens de produtos',
    description: 'Apresente até 4 fotos selecionadas de produtos, procedimentos ou serviços em destaque.',
    icon: ImageIcon,
