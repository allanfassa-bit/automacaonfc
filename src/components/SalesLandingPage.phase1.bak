      <section id="modelos" className="alf-lp-section alf-lp-section-surface border-t border-[#E2E8F0]">
        <div className="alf-lp-container space-y-10">
          <div className="flex flex-col lg:flex-row lg:items-end justify-between gap-6 text-left">
