            <div className="space-y-3 text-xs text-slate-300 leading-relaxed">
              <p>
                A <strong>ALF Automação</strong> valoriza a sua privacidade e atua em conformidade com a Lei Geral de Proteção de Dados Pessoais (Lei nº 13.709/2018 — LGPD).
              </p>
              <p>
                <strong>1. Coleta de Informações:</strong> Coletamos apenas os dados fornecidos voluntariamente no formulário de interesse comercial (nome, e-mail, telefone/WhatsApp e nome da empresa/ramo de atuação) exclusivamente para retorno consultivo e apresentação de propostas.
              </p>
              <p>
                <strong>2. Finalidade e Uso dos Dados:</strong> As informações cadastradas são utilizadas unicamente pela equipe da ALF Automação para atendimento comercial, envio de demonstrações de Placas NFC e Bio Sites e suporte técnico solicitado pelo titular.
              </p>
              <p>
                <strong>3. Compartilhamento e Segurança:</strong> Não comercializamos nem cedemos seus dados pessoais a terceiros. Aplicamos medidas técnicas de segurança e controle de acesso para proteger suas informações contra acessos não autorizados.
              </p>
              <p>
                <strong>4. Direitos do Titular:</strong> A qualquer momento você pode solicitar a confirmação, atualização ou exclusão dos seus dados de contato através do nosso canal oficial de atendimento via WhatsApp ou Instagram.
              </p>
            </div>

            <div className="pt-3 border-t border-white/10 flex justify-end">
              <button
                type="button"
                onClick={() => setIsPrivacyModalOpen(false)}
                className="alf-lp-btn-primary !py-2 !px-5 text-xs"
              >
                Entendi e fechar
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ======================================================================
          MODAL PÚBLICO DE CADASTRO DE INTERESSE / PROPOSTA COMERCIAL (PRESERVADO)
         ====================================================================== */}
      {isInterestModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md">
          <div className="bg-[#0B1220] border border-white/15 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative text-left text-white">
            <button
              type="button"
              onClick={() => setIsInterestModalOpen(false)}
              className="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 flex items-center justify-center font-bold text-xs cursor-pointer transition"
              aria-label="Fechar"
            >
              ✕
            </button>

            {!interestSubmittedSuccess ? (
              <form onSubmit={handleInterestSubmit} className="space-y-4">
                <div className="flex items-center gap-3">
                  <div className="w-14 h-10 rounded-xl bg-black border border-white/15 p-1 flex items-center justify-center shrink-0">
                    <img
                      src={ALF_LOGO_DATA_URI}
                      alt="ALF Automação"
                      className="w-full h-full object-contain"
                    />
                  </div>
                  <div>
                    <span className="alf-lp-eyebrow text-[#00B8D9] block">
                      ATENDIMENTO COMERCIAL
                    </span>
                    <h3 className="text-lg font-bold text-white mt-0.5">
                      Solicitar proposta ou solução
                    </h3>
                  </div>
                </div>

                <p className="text-xs text-slate-300 leading-relaxed">
                  Preencha seus dados de contato abaixo para registrarmos seu interesse e iniciarmos seu atendimento.
                </p>

                <div className="bg-[#172033] border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-slate-200">
                  Solução selecionada: <strong className="text-[#00B8D9]">{interestTopic}</strong>
                </div>

                {/* Hidden Honeypot Trap against automated bots */}
                <input
                  type="text"
                  name="company_website_url_trap"
                  tabIndex={-1}
                  autoComplete="off"
                  value={honeypotWebsite}
                  onChange={(e) => setHoneypotWebsite(e.target.value)}
                  className="hidden"
                />

                <div className="space-y-3">
                  <div>
                    <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                      Seu nome completo *
                    </label>
                    <input
                      type="text"
                      required
                      value={interestName}
                      onChange={(e) => setInterestName(e.target.value)}
                      placeholder="Ex: Dr. Rafael Mendes"
                      className="w-full bg-[#172033] border border-white/15 focus:border-[#00B8D9] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                    />
                  </div>

                  <div>
                    <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                      Seu e-mail profissional *
                    </label>
                    <input
                      type="email"
                      required
                      value={interestEmail}
                      onChange={(e) => setInterestEmail(e.target.value)}
                      placeholder="contato@suaempresa.com.br"
                      className="w-full bg-[#172033] border border-white/15 focus:border-[#00B8D9] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                    />
                  </div>

                  <div>
                    <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                      Telefone / WhatsApp (com DDD) *
                    </label>
                    <input
                      type="tel"
                      required
                      value={interestPhone}
                      onChange={(e) => setInterestPhone(e.target.value)}
                      placeholder="(14) 99999-9999"
                      className="w-full bg-[#172033] border border-white/15 focus:border-[#00B8D9] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                    />
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <div>
                      <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                        Empresa / Clínica
                      </label>
                      <input
                        type="text"
                        value={interestCompany}
                        onChange={(e) => setInterestCompany(e.target.value)}
                        placeholder="Nome do negócio"
                        className="w-full bg-[#172033] border border-white/15 focus:border-[#00B8D9] rounded-xl px-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                        Segmento
                      </label>
                      <input
                        type="text"
                        value={interestNicheInput}
                        onChange={(e) => setInterestNicheInput(e.target.value)}
                        placeholder="Ex: Saúde, Imóveis..."
                        className="w-full bg-[#172033] border border-white/15 focus:border-[#00B8D9] rounded-xl px-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                      />
                    </div>
                  </div>
                </div>

                {interestError && (
                  <div className="p-3 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-200 text-xs font-medium">
                    {interestError}
                  </div>
                )}

                <button
                  type="submit"
                  disabled={isSubmittingInterest}
                  className="alf-lp-btn-primary w-full justify-center disabled:opacity-50"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>
                    {isSubmittingInterest ? 'Enviando solicitação...' : 'Confirmar solicitação'}
                  </span>
                </button>

                <div className="pt-1 text-center">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automação! Tenho interesse em: ${interestTopic}. Gostaria de atendimento pelo WhatsApp.`
                    )}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="text-xs text-slate-400 hover:text-[#00B8D9] inline-flex items-center gap-1.5 transition"
                  >
                    <MessageCircle className="w-3.5 h-3.5 text-emerald-400" />
                    <span>Ou falar diretamente pelo WhatsApp agora</span>
                  </a>
                </div>
              </form>
            ) : (
              <div className="text-center space-y-4 py-3">
                <div className="w-14 h-14 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-8 h-8" />
                </div>
                <div className="space-y-1">
                  <span className="text-[10px] font-mono uppercase tracking-widest text-emerald-400">
                    SOLICITAÇÃO REGISTRADA
                  </span>
                  <h4 className="text-xl font-bold text-white">
                    Recebemos seu contato, {interestName.split(' ')[0]}!
                  </h4>
                  <p className="text-xs text-slate-300 leading-relaxed">
                    Seus dados (<strong>{interestEmail}</strong> • <strong>{interestPhone}</strong>) foram registrados para atendimento sobre <strong>{interestTopic}</strong>.
                  </p>
                </div>

                <div className="pt-2 space-y-2.5">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automação! Me chamo ${interestName} (${interestCompany || interestNicheInput}). Acabei de registrar meu interesse no site sobre: ${interestTopic}.`
                    )}`}
                    target="_blank"
                    rel="noreferrer"
                    className="alf-lp-btn-primary w-full justify-center"
                  >
                    <MessageCircle className="w-4 h-4" />
                    <span>Continuar atendimento no WhatsApp</span>
                  </a>

                  <button
                    type="button"
                    onClick={() => setIsInterestModalOpen(false)}
                    className="alf-lp-btn-secondary-dark w-full justify-center text-xs"
                  >
                    Voltar para a página
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* ======================================================================
          CENTRAL DE DEMONSTRAÇÕES INTERATIVAS (PRESERVADA)
         ====================================================================== */}
      {isDemoModalOpen && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-950/85 backdrop-blur-xl overflow-y-auto"
          onClick={(e) => {
            if (e.target === e.currentTarget) setIsDemoModalOpen(false);
          }}
        >
          <div className="relative w-full max-w-5xl my-auto rounded-3xl bg-[#0B1220] border border-white/15 p-5 sm:p-8 shadow-2xl text-slate-100 space-y-6 max-h-[92vh] overflow-y-auto">
            <div className="flex items-start justify-between gap-4 border-b border-white/10 pb-5">
              <div className="space-y-1 text-left">
                <span className="alf-lp-eyebrow text-[#00B8D9] block">
                  CENTRAL DE DEMONSTRAÇÕES • ALF AUTOMAÇÃO
                </span>
                <h3 className="text-xl sm:text-2xl font-bold text-white tracking-tight">
                  Selecione um modelo de Bio Site para testar
                </h3>
              </div>

              <button
                type="button"
                onClick={() => setIsDemoModalOpen(false)}
                className="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white flex items-center justify-center border border-white/10 transition cursor-pointer shrink-0"
                aria-label="Fechar Central de Demonstrações"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-left">
              {publicShowcaseModels.map((tmpl) => (
                <div
                  key={tmpl.id}
                  className="rounded-2xl bg-[#172033]/80 border border-white/10 p-5 flex flex-col justify-between gap-4"
                >
                  <div className="space-y-2">
                    <div className="flex items-center justify-between">
                      <span className="text-[11px] font-mono text-[#00B8D9]">
                        {tmpl.emoji} {tmpl.category}
                      </span>
                    </div>
                    <h4 className="text-base font-semibold text-white">{tmpl.title}</h4>
                    <p className="text-xs text-slate-300 leading-relaxed line-clamp-3">
                      {tmpl.config.bio}
                    </p>
                  </div>

                  <div className="grid grid-cols-2 gap-2 pt-3 border-t border-white/10">
                    <button
                      type="button"
                      onClick={() => {
                        setSelectedShowcaseMockupId(tmpl.id);
                        setIsDemoModalOpen(false);
                        setFullscreenEmulationMockup(tmpl);
                      }}
                      className="alf-lp-btn-primary !py-2 !px-3 text-xs"
                    >
                      <Eye className="w-3.5 h-3.5" />
                      <span>Tela cheia</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => {
                        setIsDemoModalOpen(false);
                        openInterestModal(`Bio Site + Cartão NFC — Modelo: ${tmpl.category}`);
                      }}
                      className="alf-lp-btn-secondary-dark !py-2 !px-3 text-xs"
                    >
                      <span>Quero este</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* ======================================================================
          MODAL DE EMULAÇÃO EM TELA CHEIA DOS BIO SITES (PRESERVADO)
         ====================================================================== */}
      {fullscreenEmulationMockup && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-2xl flex flex-col overflow-hidden"
        >
          {/* Barra superior da Emulação em Tela Cheia */}
          <div className="w-full bg-[#0B1220] border-b border-white/10 px-4 py-3 flex flex-wrap items-center justify-between gap-3 shrink-0 z-20">
            <div className="flex items-center gap-3">
              <span className="text-xl">{fullscreenEmulationMockup.emoji}</span>
              <div className="text-left">
                <div className="flex items-center gap-2">
                  <span className="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#00B8D9] bg-[#00B8D9]/10 px-2 py-0.5 rounded border border-[#00B8D9]/30">
                    Demonstração Interativa
                  </span>
                  <span className="text-xs text-slate-400 hidden sm:inline">
                    • {fullscreenEmulationMockup.category}
                  </span>
                </div>
                <strong className="text-xs sm:text-sm font-semibold text-white block mt-0.5">
                  {fullscreenEmulationMockup.title}
                </strong>
              </div>
            </div>

            {/* Seletor rápido de modelos dentro da tela cheia */}
            <div className="hidden xl:flex items-center gap-1.5 bg-[#172033] p-1 rounded-xl border border-white/10">
              {publicShowcaseModels.map((m) => {
                const active = m.id === fullscreenEmulationMockup.id;
                return (
                  <button
                    key={m.id}
                    type="button"
                    onClick={() => {
                      setFullscreenEmulationMockup(m);
                      setSelectedShowcaseMockupId(m.id);
                    }}
                    className={`px-2.5 py-1.5 rounded-lg text-[11px] font-medium transition cursor-pointer flex items-center gap-1 ${
                      active
                        ? 'bg-[#00B8D9] text-[#0B1220] font-semibold'
                        : 'text-slate-300 hover:text-white hover:bg-white/5'
                    }`}
                  >
                    <span>{m.emoji}</span>
                    <span>{m.category.split(' ')[0]}</span>
                  </button>
                );
              })}
            </div>

            <div className="flex items-center gap-2.5">
              <button
                type="button"
                onClick={() => {
                  const chosen = fullscreenEmulationMockup;
                  setFullscreenEmulationMockup(null);
                  openInterestModal(
                    `Bio Site + Cartão NFC — Modelo: ${chosen.category} (${chosen.title})`
                  );
                }}
                className="alf-lp-btn-primary !py-2 !px-4 text-xs"
              >
                <span>Quero este modelo</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </button>

              <button
                type="button"
                onClick={() => setFullscreenEmulationMockup(null)}
                className="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white font-medium text-xs flex items-center gap-1.5 border border-white/15 cursor-pointer transition"
              >
                <X className="w-4 h-4" />
                <span>Fechar demonstração</span>
              </button>
            </div>
          </div>

          {/* Viewport da Emulação */}
          <div className="flex-1 overflow-y-auto bg-black">
            <MiniSiteViewer
              key={`fullscreen-${fullscreenEmulationMockup.id}`}
              standalone={true}
              config={fullscreenEmulationMockup.config}
              leadId={fullscreenEmulationMockup.id}
            />
          </div>
        </div>
      )}
    </div>
  );
};
