                            src={tmpl.config.logoUrl}
                            alt={tmpl.title}
                            className="w-12 h-12 rounded-xl object-cover border border-white/15 shrink-0"
                          />
                        ) : (
                          <div className="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-lg shrink-0">
                            {tmpl.emoji}
