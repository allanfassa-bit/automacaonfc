import React, { useState, useMemo, useEffect, useRef } from 'react';
import {
  Smartphone,
  QrCode,
  Globe,
  Zap,
  Shield,
  CheckCircle2,
  ArrowRight,
  MessageCircle,
  Instagram,
  Wifi,
  ChevronRight,
  ChevronDown,
  Check,
  Palette,
  Camera,
  Layers,
  Play,
  Eye,
  Radio,
  X,
  Menu,
  Sliders,
  Image as ImageIcon,
  Link2,
  Lock,
  ExternalLink
} from 'lucide-react';
import {
  ALF_LOGO_DATA_URI,
  READY_MINISITE_MOCKUPS,
  ReadyMockupTemplate
} from '../utils/readyMiniSiteMockups';
import { MiniSiteViewer } from './MiniSiteViewer';
import '../styles/salesLanding.css';

export interface InterestLeadPayload {
  name: string;
  email: string;
  phone: string;
  companyName: string;
  niche: string;
  interestType: string;
}

export interface SalesLandingPageProps {
  onOpenLogin: (suggestedTab?: string) => void;
  onExploreDemo?: () => void;
  initialNiche?: string;
  onRegisterInterest?: (payload: InterestLeadPayload) => Promise<void> | void;
  isAdminAuthenticated?: boolean;
  onGoToAdminPanel?: () => void;
}

const SHOWCASE_PUBLIC_MODEL_IDS = [
  'bio_medica',
  'modelo_corretor_demo',
  'modelo_bio_pessoal_demo',
  'cafe',
  'bio_estetica_facial',
  'hamburgueria'
];

const MODEL_SEGMENT_GROUP: Record<string, 'saude' | 'executivo' | 'gastronomia'> = {
  bio_medica: 'saude',
  bio_estetica_facial: 'saude',
  modelo_corretor_demo: 'executivo',
  modelo_bio_pessoal_demo: 'executivo',
  cafe: 'gastronomia',
  hamburgueria: 'gastronomia'
};

const PORTAL_CUSTOMIZATION_ITEMS = [
  {
    number: '01',
    title: 'Cor do Bio Site',
    description: 'Defina a cor de destaque do seu modelo para alinhar o Bio Site à identidade visual da sua marca.',
    icon: Palette,
