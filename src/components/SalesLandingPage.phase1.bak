                    {publicShowcaseModels.map((m) => (
                      <button
                        key={m.id}
                        type="button"
                        onClick={() => setSelectedShowcaseMockupId(m.id)}
                        className={`px-3 py-1.5 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-1.5 ${
                          selectedShowcaseMockup.id === m.id
                            ? 'bg-[#0B1220] text-white'
                            : 'bg-white text-[#64748B] hover:text-[#111827] border border-[#E2E8F0]'
                        }`}
                      >
                        <span>{m.emoji}</span>
                        <span>{m.category}</span>
                      </button>
                    ))}
                  </div>
                </div>

                <div className="pt-2 flex flex-col sm:flex-row gap-3">
                  <button
                    type="button"
                    onClick={() => setFullscreenEmulationMockup(selectedShowcaseMockup)}
                    className="alf-lp-btn-dark text-xs"
                  >
                    <Eye className="w-4 h-4 text-[#00B8D9]" />
                    <span>Abrir demonstração em tela cheia</span>
                  </button>

                  <button
                    type="button"
                    onClick={() =>
                      openInterestModal(
                        `Bio Site + Cartão NFC — Modelo: ${selectedShowcaseMockup.category}`
                      )
                    }
                    className="alf-lp-btn-outline-light text-xs"
                  >
                    <span>Solicitar este modelo</span>
                  </button>
                </div>
              </div>

              <div className="lg:col-span-7 flex justify-center">
                <div className="w-full max-w-md rounded-[38px] p-2.5 bg-[#0B1220] border-4 border-[#172033] shadow-2xl">
                  <div className="rounded-[30px] overflow-hidden max-h-[640px] overflow-y-auto bg-black">
                    <MiniSiteViewer
                      key={selectedShowcaseMockup.id}
                      standalone={true}
                      config={selectedShowcaseMockup.config}
                      leadId={selectedShowcaseMockup.id}
                      onChangeConfig={(updated) => {
                        const matched = READY_MINISITE_MOCKUPS.find(
                          (m) =>
                            m.id === updated.id ||
                            m.config.id === updated.id ||
                            m.config.companyName === updated.companyName
                        );
                        if (matched) {
                          setSelectedShowcaseMockupId(matched.id);
                        }
                      }}
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
