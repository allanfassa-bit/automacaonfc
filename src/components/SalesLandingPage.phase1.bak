            <div className="flex flex-wrap items-center gap-2">
              {[
                { id: 'all', label: 'Todos os segmentos' },
                { id: 'saude', label: 'Saúde & Estética' },
                { id: 'executivo', label: 'Imobiliário & Executivo' },
                { id: 'gastronomia', label: 'Cafeteria & Gastronomia' }
              ].map((tab) => (
                <button
                  key={tab.id}
                  type="button"
                  onClick={() => setSegmentFilter(tab.id as 'all' | 'saude' | 'executivo' | 'gastronomia')}
                  className={`px-4 py-2 rounded-xl text-xs font-semibold transition cursor-pointer ${
                    segmentFilter === tab.id
                      ? 'bg-[#0B1220] text-white shadow-sm'
                      : 'bg-[#F8FAFC] text-[#64748B] hover:text-[#111827] border border-[#E2E8F0]'
                  }`}
                >
                  {tab.label}
                </button>
              ))}
            </div>
          </div>

