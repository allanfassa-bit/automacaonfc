                    </div>
                    <div>
                      <label className="block text-[11px] font-semibold text-zinc-300 uppercase tracking-wider mb-1">
                        Segmento
                      </label>
                      <input
                        type="text"
                        value={interestNicheInput}
                        onChange={(e) => setInterestNicheInput(e.target.value)}
                        placeholder="Ex: Clínica, Café..."
                        className="w-full bg-black border border-white/15 focus:border-[#2563EB] rounded-xl px-3 py-2 text-xs text-white placeholder-zinc-500 focus:outline-hidden transition"
                      />
                    </div>
                  </div>
                </div>

                {interestError && (
                  <div className="p-3 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-200 text-xs font-medium">
                    {interestError}
                  </div>
                )}

                <button
                  type="submit"
                  disabled={isSubmittingInterest}
                  className="alf-lp-btn-blue w-full justify-center disabled:opacity-50"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>
                    {isSubmittingInterest ? 'Enviando...' : 'Continuar solicitação'}
                  </span>
                </button>

                <div className="pt-1 text-center">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automação! Tenho interesse em: ${interestTopic}.`
                    )}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="text-xs text-zinc-400 hover:text-white inline-flex items-center gap-1.5 transition"
                  >
                    <MessageCircle className="w-3.5 h-3.5 text-[#2563EB]" />
                    <span>Prefiro falar diretamente no WhatsApp</span>
                  </a>
                </div>
              </form>
            ) : (
              <div className="text-center space-y-4 py-3">
                <div className="w-12 h-12 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-6 h-6" />
                </div>
                <div className="space-y-1">
                  <h4 className="text-lg font-bold text-white">
                    Solicitação registrada, {interestName.split(' ')[0]}!
                  </h4>
                  <p className="text-xs text-zinc-300 leading-relaxed">
                    Recebemos seu contato para <strong>{interestTopic}</strong>.
                  </p>
                </div>

                <div className="pt-2 space-y-2.5">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automação! Me chamo ${interestName}. Registrei meu interesse no site sobre: ${interestTopic}.`
                    )}`}
                    target="_blank"
                    rel="noreferrer"
                    className="alf-lp-btn-blue w-full justify-center"
                  >
                    <MessageCircle className="w-4 h-4" />
                    <span>Concluir pelo WhatsApp</span>
                  </a>

                  <button
                    type="button"
                    onClick={() => setIsInterestModalOpen(false)}
                    className="alf-lp-btn-ghost-dark w-full justify-center text-xs"
                  >
                    Fechar
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* MODAL DE DEMONSTRAÇÃO INTERATIVA DOS BIO SITES */}
      {fullscreenEmulationMockup && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl flex flex-col overflow-hidden"
        >
          <div className="w-full bg-[#050505] border-b border-white/10 px-3 sm:px-5 py-2.5 shrink-0 z-20 space-y-2">
            <div className="flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 min-w-0 flex-1">
                <span className="text-base sm:text-xl shrink-0">{fullscreenEmulationMockup.emoji}</span>
                <div className="text-left min-w-0 flex-1">
                  <span className="text-[10px] sm:text-[11px] font-medium text-[#2563EB] block truncate">
                    Demonstração — {fullscreenEmulationMockup.category}
                  </span>
                  <strong className="text-xs sm:text-sm font-semibold text-white block truncate">
                    {fullscreenEmulationMockup.config.companyName || fullscreenEmulationMockup.title}
                  </strong>
                </div>
              </div>

              <div className="hidden xl:flex items-center gap-1.5 bg-[#0C0C0E] p-1 rounded-xl border border-white/10">
                {publicShowcaseModels.map((m) => {
                  const active = m.id === fullscreenEmulationMockup.id;
                  return (
                    <button
                      key={m.id}
                      type="button"
                      onClick={() => {
                        setFullscreenEmulationMockup(m);
                        setSelectedShowcaseMockupId(m.id);
                      }}
                      className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-1 ${
                        active
                          ? 'bg-[#2563EB] text-white'
                          : 'text-zinc-400 hover:text-white hover:bg-white/5'
                      }`}
                    >
                      <span>{m.emoji}</span>
                      <span>{m.category.split(' ')[0]}</span>
                    </button>
                  );
                })}
              </div>

              <div className="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                <button
                  type="button"
                  onClick={() => {
                    const chosen = fullscreenEmulationMockup;
                    setFullscreenEmulationMockup(null);
                    openInterestModal(
                      `Bio Site + Cartão NFC — Modelo: ${chosen.category} (${chosen.title})`
                    );
                  }}
                  className="alf-lp-btn-blue !py-1.5 sm:!py-2 !px-3 sm:!px-4 !text-[11px] sm:!text-xs whitespace-nowrap"
                >
                  <span>Quero este modelo</span>
                </button>

                <button
                  type="button"
                  onClick={() => setFullscreenEmulationMockup(null)}
                  className="px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-full bg-white/10 hover:bg-white/15 text-white font-medium text-[11px] sm:text-xs flex items-center gap-1 border border-white/15 cursor-pointer transition shrink-0"
                  aria-label="Fechar demonstração"
                >
                  <X className="w-3.5 h-3.5 sm:w-4 sm:h-4" />
                  <span className="hidden sm:inline">Fechar</span>
                </button>
              </div>
            </div>

            <div className="xl:hidden flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
              {publicShowcaseModels.map((m) => {
                const active = m.id === fullscreenEmulationMockup.id;
                return (
                  <button
                    key={m.id}
                    type="button"
                    onClick={() => {
                      setFullscreenEmulationMockup(m);
                      setSelectedShowcaseMockupId(m.id);
                    }}
                    className={`px-2.5 py-1 rounded-full text-[11px] font-medium whitespace-nowrap transition cursor-pointer flex items-center gap-1 shrink-0 ${
                      active
                        ? 'bg-[#2563EB] text-white'
                        : 'bg-[#0C0C0E] text-zinc-400 border border-white/10'
                    }`}
                  >
                    <span>{m.emoji}</span>
                    <span>{m.category}</span>
                  </button>
                );
              })}
            </div>
          </div>

          <div className="flex-1 overflow-y-auto bg-black">
            <MiniSiteViewer
              key={`fullscreen-${fullscreenEmulationMockup.id}`}
              standalone={true}
              config={fullscreenEmulationMockup.config}
              leadId={fullscreenEmulationMockup.id}
            />
          </div>
        </div>
      )}
    </div>
  );
};
