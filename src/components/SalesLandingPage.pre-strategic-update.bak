import React, { useState, useMemo, useEffect, useRef } from 'react';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import {
  Shield,
  CheckCircle2,
  ArrowRight,
  MessageCircle,
  Instagram,
  Eye,
  X,
  Menu,
  Calendar,
  Phone,
  MapPin
} from 'lucide-react';
import {
  ALF_LOGO_DATA_URI,
  READY_MINISITE_MOCKUPS,
  ReadyMockupTemplate
} from '../utils/readyMiniSiteMockups';
import { MiniSiteViewer } from './MiniSiteViewer';
import '../styles/salesLanding.css';

gsap.registerPlugin(ScrollTrigger);

export interface InterestLeadPayload {
  name: string;
  email: string;
  phone: string;
  companyName: string;
  niche: string;
  interestType: string;
}

export interface SalesLandingPageProps {
  onOpenLogin: (suggestedTab?: string) => void;
  onExploreDemo?: () => void;
  initialNiche?: string;
  onRegisterInterest?: (payload: InterestLeadPayload) => Promise<void> | void;
  isAdminAuthenticated?: boolean;
  onGoToAdminPanel?: () => void;
}

// Instant zero-latency poster matching the matte black ALF NFC Card video on #050505
const ALF_CARD_VIDEO_POSTER_URI = `data:image/svg+xml;utf8,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 540" width="960" height="540">
    <rect width="960" height="540" fill="#050505"/>
    <defs>
      <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1E2024"/>
        <stop offset="50%" stop-color="#0D0E11"/>
        <stop offset="100%" stop-color="#07080A"/>
      </linearGradient>
      <linearGradient id="edgeGlow" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.32"/>
        <stop offset="50%" stop-color="#38bdf8" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0.08"/>
      </linearGradient>
    </defs>
    <rect x="230" y="110" width="500" height="320" rx="26" fill="url(#cardGrad)" stroke="url(#edgeGlow)" stroke-width="2"/>
    <text x="275" y="165" fill="#A1A1AA" font-family="sans-serif" font-size="16" font-weight="700" letter-spacing="3">ALF</text>
    <text x="275" y="255" fill="#E4E4E7" font-family="sans-serif" font-size="52" font-weight="700" letter-spacing="2">MEU</text>
    <text x="275" y="295" fill="#A1A1AA" font-family="sans-serif" font-size="27" font-weight="500" letter-spacing="6">CARTÃO</text>
    <path d="M645 245 a24 24 0 0 1 0 38 M657 236 a38 38 0 0 1 0 56 M669 227 a52 52 0 0 1 0 74" fill="none" stroke="#7DD3FC" stroke-width="4" stroke-linecap="round" opacity="0.8"/>
    <text x="645" y="395" fill="#A1A1AA" font-family="sans-serif" font-size="13" font-weight="700" letter-spacing="2">ALF</text>
  </svg>`
)}`;

const SHOWCASE_PUBLIC_MODEL_IDS = [
  'bio_medica',
  'modelo_bio_pessoal_demo',
  'modelo_corretor_demo',
  'cafe',
  'bio_estetica_facial',
  'hamburgueria'
];

export const SalesLandingPage: React.FC<SalesLandingPageProps> = ({
  onOpenLogin,
  initialNiche,
  onRegisterInterest,
  isAdminAuthenticated,
  onGoToAdminPanel
}) => {
  const [selectedShowcaseMockupId, setSelectedShowcaseMockupId] = useState<string>(() => {
    if (initialNiche) {
      const matched = READY_MINISITE_MOCKUPS.find(
        (m) =>
          SHOWCASE_PUBLIC_MODEL_IDS.includes(m.id) &&
          (m.id.toLowerCase().includes(initialNiche.toLowerCase()) ||
            m.category.toLowerCase().includes(initialNiche.toLowerCase()))
      );
      if (matched) return matched.id;
    }
    return 'bio_medica';
  });

  const [activeScene, setActiveScene] = useState<1 | 2 | 3 | 4>(1);
  const [fullscreenEmulationMockup, setFullscreenEmulationMockup] = useState<ReadyMockupTemplate | null>(null);
  const [isHeaderScrolled, setIsHeaderScrolled] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isPrivacyModalOpen, setIsPrivacyModalOpen] = useState(false);

  // Public Interest Capture Modal State (preserves honeypot & rate limiting)
  const [isInterestModalOpen, setIsInterestModalOpen] = useState(false);
  const [interestTopic, setInterestTopic] = useState<string>('Bio Site + Cartão NFC (R$ 1.199,00)');
  const [interestName, setInterestName] = useState('');
  const [interestEmail, setInterestEmail] = useState('');
  const [interestPhone, setInterestPhone] = useState('');
  const [interestCompany, setInterestCompany] = useState('');
  const [interestNicheInput, setInterestNicheInput] = useState('');
  const [honeypotWebsite, setHoneypotWebsite] = useState('');
  const [isSubmittingInterest, setIsSubmittingInterest] = useState(false);
  const [interestSubmittedSuccess, setInterestSubmittedSuccess] = useState(false);
  const [interestError, setInterestError] = useState('');
  const [lastSubmitTimestamp, setLastSubmitTimestamp] = useState<number>(0);

  // Refs for GSAP Hero Storytelling & Secret Footer Login
  const rootRef = useRef<HTMLDivElement | null>(null);
  const heroPinWrapperRef = useRef<HTMLElement | null>(null);
  const heroStageRef = useRef<HTMLDivElement | null>(null);
  const cardVideoRef = useRef<HTMLVideoElement | null>(null);
  const secretLogoClicksRef = useRef<{ count: number; lastClick: number }>({ count: 0, lastClick: 0 });

  const openInterestModal = (topic?: string) => {
    if (topic) setInterestTopic(topic);
    setInterestSubmittedSuccess(false);
    setInterestError('');
    setIsInterestModalOpen(true);
  };

  const handleSecretFooterLogoClick = () => {
    const now = Date.now();
    if (now - secretLogoClicksRef.current.lastClick > 2500) {
      secretLogoClicksRef.current.count = 1;
    } else {
      secretLogoClicksRef.current.count += 1;
    }
    secretLogoClicksRef.current.lastClick = now;
    if (secretLogoClicksRef.current.count >= 5) {
      secretLogoClicksRef.current.count = 0;
      onOpenLogin();
    }
  };

  const handleInterestSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setInterestError('');

    if (honeypotWebsite.trim().length > 0) {
      setInterestSubmittedSuccess(true);
      return;
    }

    const now = Date.now();
    if (now - lastSubmitTimestamp < 30000) {
      setInterestError('Aguarde alguns segundos antes de enviar uma nova solicitação.');
      return;
    }

    const cleanName = interestName.trim();
    const cleanEmail = interestEmail.trim().toLowerCase();
    const cleanPhone = interestPhone.replace(/\D/g, '');
    const cleanCompany = interestCompany.trim() || cleanName;

    if (!cleanName || cleanName.length < 2) {
      setInterestError('Por favor, informe seu nome completo.');
      return;
    }
    if (!cleanEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      setInterestError('Por favor, informe um e-mail válido para contato.');
      return;
    }
    if (!cleanPhone || cleanPhone.length < 10) {
      setInterestError('Por favor, informe seu WhatsApp ou telefone com DDD.');
      return;
    }

    setIsSubmittingInterest(true);
    try {
      if (onRegisterInterest) {
        await onRegisterInterest({
          name: cleanName,
          email: cleanEmail,
          phone: cleanPhone,
          companyName: cleanCompany,
          niche: interestNicheInput.trim() || 'Não informado',
          interestType: interestTopic
        });
      }
      setLastSubmitTimestamp(Date.now());
      setInterestSubmittedSuccess(true);
    } catch (_) {
      setInterestSubmittedSuccess(true);
    } finally {
      setIsSubmittingInterest(false);
    }
  };

  const publicShowcaseModels: ReadyMockupTemplate[] = useMemo(() => {
    return SHOWCASE_PUBLIC_MODEL_IDS.map((id) =>
      READY_MINISITE_MOCKUPS.find((m) => m.id === id)
    ).filter((m): m is ReadyMockupTemplate => Boolean(m));
  }, []);

  useEffect(() => {
    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      setIsHeaderScrolled(y > 16);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  // Ensure silent video playback when mounted
  useEffect(() => {
    const videoEl = cardVideoRef.current;
    if (!videoEl) return;
    videoEl.muted = true;
    videoEl.play().catch(() => {
      // Poster fallback stays visible if browser blocks autoplay
    });
  }, []);

  // Subtle GSAP transition whenever activeScene changes (fade, subtle vertical shift & scale)
  useEffect(() => {
    if (typeof window === 'undefined' || !heroStageRef.current) return;
    const motionReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (motionReduced) return;

    const ctx = gsap.context(() => {
      gsap.fromTo(
        '.alf-active-scene-copy',
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out', overwrite: 'auto' }
      );
      gsap.fromTo(
        '.alf-active-scene-visual',
        { opacity: 0, y: 22, scale: 0.96 },
        { opacity: 1, y: 0, scale: 1, duration: 0.65, ease: 'power2.out', overwrite: 'auto' }
      );
    }, heroStageRef);

    return () => ctx.revert();
  }, [activeScene]);

  // GSAP ScrollTrigger — Desktop 4-Scene Scroll Storytelling + Mobile Lightweight Reveal
  useEffect(() => {
    if (typeof window === 'undefined' || !rootRef.current || !heroPinWrapperRef.current) return;

    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();

      // Desktop (>= 1024px): Smooth ScrollTrigger progression across the 4 scenes
      mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
        ScrollTrigger.create({
          trigger: heroPinWrapperRef.current,
          start: 'top top+=72',
          end: '+=1500',
          pin: true,
          scrub: 0.4,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            const p = self.progress;
            if (p < 0.25) {
              setActiveScene((prev) => (prev !== 1 ? 1 : prev));
            } else if (p < 0.52) {
              setActiveScene((prev) => (prev !== 2 ? 2 : prev));
            } else if (p < 0.78) {
              setActiveScene((prev) => (prev !== 3 ? 3 : prev));
            } else {
              setActiveScene((prev) => (prev !== 4 ? 4 : prev));
            }
          }
        });
      });

      // Mobile (< 1024px): Short, clean entrance without trapping scroll
      mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
        gsap.fromTo(
          '.alf-mobile-scene-block',
          { opacity: 0, y: 20 },
          {
            opacity: 1,
            y: 0,
            duration: 0.55,
            stagger: 0.1,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: heroPinWrapperRef.current,
              start: 'top 85%'
            }
          }
        );
      });
    }, rootRef);

    const handleResize = () => {
      ScrollTrigger.refresh();
    };
    window.addEventListener('resize', handleResize);

    return () => {
      window.removeEventListener('resize', handleResize);
      ctx.revert();
    };
  }, []);

  const medicalMockup = useMemo(
    () =>
      publicShowcaseModels.find((m) => m.id === 'bio_medica') ||
      publicShowcaseModels[0] ||
      READY_MINISITE_MOCKUPS[0],
    [publicShowcaseModels]
  );

  return (
    <div ref={rootRef} className="alf-lp-root min-h-screen">
      {/* Barra de retorno caso o administrador já esteja autenticado */}
      {isAdminAuthenticated && onGoToAdminPanel && (
        <div className="bg-[#0A0A0D] border-b border-white/10 py-2 px-4 text-xs text-zinc-300">
          <div className="alf-lp-container flex items-center justify-between gap-4">
            <span className="flex items-center gap-2 font-medium truncate">
              <span className="w-2 h-2 rounded-full bg-emerald-400 shrink-0" />
              <span className="truncate">Sessão administrativa ativa</span>
            </span>
            <button
              type="button"
              onClick={onGoToAdminPanel}
              className="text-white hover:text-blue-400 font-semibold flex items-center gap-1 cursor-pointer transition shrink-0"
            >
              <span>Voltar ao Console</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      )}

      {/* HEADER MINIMALISTA (#050505) */}
      <header className={`alf-lp-header ${isHeaderScrolled ? 'is-scrolled' : ''}`}>
        <div className="alf-lp-container h-full flex items-center justify-between gap-4">
          <a href="#" className="alf-lp-brand-lockup shrink-0">
            <div className="alf-lp-brand-emblem">
              <img
                src="/alf-logo.jpg"
                alt="ALF Automação"
                className="w-full h-full object-contain"
              />
            </div>
            <div className="text-left leading-tight">
              <span className="font-bold text-white text-sm sm:text-base tracking-tight block">
                ALF Automação
              </span>
              <span className="text-[10px] text-zinc-400 tracking-wider uppercase block">
                NFC &amp; Presença Digital
              </span>
            </div>
          </a>

          <nav className="hidden lg:flex items-center gap-8 text-sm font-medium text-zinc-400">
            <a href="#solucoes" className="hover:text-white transition-colors">
              Soluções
            </a>
            <a href="#modelos" className="hover:text-white transition-colors">
              Modelos de Bio Site
            </a>
            <button
              type="button"
              onClick={() => openInterestModal('Atendimento Comercial ALF Automação')}
              className="hover:text-white transition-colors cursor-pointer"
            >
              Contato
            </button>
          </nav>

          <div className="flex items-center gap-2.5 shrink-0">
            <a
              href="#solucoes"
              className="hidden sm:inline-flex alf-lp-btn-primary !py-2 !px-4 !text-xs"
            >
              <span>Conhecer soluções</span>
            </a>

            <button
              type="button"
              onClick={() => setIsMobileMenuOpen((prev) => !prev)}
              className="lg:hidden w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center cursor-pointer transition"
              aria-label={isMobileMenuOpen ? 'Fechar menu' : 'Abrir menu'}
            >
              {isMobileMenuOpen ? <X className="w-4 h-4" /> : <Menu className="w-4 h-4" />}
            </button>
          </div>
        </div>

        {/* Menu Mobile */}
        {isMobileMenuOpen && (
          <div className="lg:hidden bg-[#050505]/98 backdrop-blur-xl border-b border-white/10 px-6 py-5 space-y-4">
            <nav className="flex flex-col space-y-3 text-sm font-medium text-zinc-300">
              <a
                href="#solucoes"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-white transition-colors"
              >
                Soluções
              </a>
              <a
                href="#modelos"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-1.5 hover:text-white transition-colors"
              >
                Modelos de Bio Site
              </a>
              <button
                type="button"
                onClick={() => {
                  setIsMobileMenuOpen(false);
                  openInterestModal('Atendimento Comercial ALF Automação');
                }}
                className="py-1.5 text-left hover:text-white transition-colors cursor-pointer"
              >
                Solicitar atendimento
              </button>
            </nav>
          </div>
        )}
      </header>

      {/* ======================================================================
          HERO CINEMATOGRÁFICO & INTERATIVO (APPLE PRODUCT STAGE — #050505)
          4 Cenas com os Assets Reais Fornecidos
         ====================================================================== */}
      <section
        ref={heroPinWrapperRef}
        className="alf-lp-hero-bg relative min-h-[calc(100vh-72px)] flex flex-col justify-between py-8 sm:py-12 lg:py-14 overflow-hidden"
      >
        <div ref={heroStageRef} className="alf-lp-container w-full my-auto">
          {/* Navegação Discreta das 4 Cenas (funciona por scroll no desktop ou toque em qualquer tela) */}
          <div className="flex items-center justify-center lg:justify-start gap-2 sm:gap-3 mb-8 sm:mb-10">
            {[
              { id: 1, label: '01. Cartão NFC' },
              { id: 2, label: '02. Placa Google' },
              { id: 3, label: '03. Bio Site' },
              { id: 4, label: '04. Conversão' }
            ].map((sceneItem) => {
              const isCurrent = activeScene === sceneItem.id;
              return (
                <button
                  key={sceneItem.id}
                  type="button"
                  onClick={() => setActiveScene(sceneItem.id as 1 | 2 | 3 | 4)}
                  className={`px-3 sm:px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-medium transition cursor-pointer ${
                    isCurrent
                      ? 'bg-white text-[#050505] font-semibold'
                      : 'bg-white/[0.04] text-zinc-400 hover:text-white border border-white/10'
                  }`}
                >
                  {sceneItem.label}
                </button>
              );
            })}
          </div>

          {/* PALCO CENTRAL DAS 4 CENAS */}
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center min-h-[480px] lg:min-h-[520px]">
            {/* COLUNA ESQUERDA: TIPOGRAFIA APPLE DE ALTO CONTRASTE + 1 CTA PRINCIPAL POR CENA */}
            <div className="lg:col-span-5 text-center lg:text-left">
              {activeScene === 1 && (
                <div className="alf-active-scene-copy alf-gsap-scene space-y-6">
                  <span className="alf-lp-kicker text-[#2563EB] block">
                    ALF AUTOMAÇÃO • IDENTIDADE DIGITAL
                  </span>
                  <h1 className="alf-lp-h1">
                    Sua empresa merece ser encontrada.
                  </h1>
                  <p className="text-base sm:text-lg text-zinc-400 max-w-md mx-auto lg:mx-0 leading-relaxed">
                    Mais avaliações. Uma apresentação profissional. Conexões mais simples.
                  </p>
                  <div className="pt-2">
                    <a href="#solucoes" className="alf-lp-btn-primary">
                      <span>Conhecer soluções</span>
                      <ArrowRight className="w-4 h-4" />
                    </a>
                  </div>
                </div>
              )}

              {activeScene === 2 && (
                <div className="alf-active-scene-copy alf-gsap-scene space-y-6">
                  <span className="alf-lp-kicker text-[#2563EB] block">
                    PLACA NFC GOOGLE
                  </span>
                  <h1 className="alf-lp-h1">
                    Seu cliente gostou? Facilite a avaliação.
                  </h1>
                  <p className="text-base sm:text-lg text-zinc-400 max-w-md mx-auto lg:mx-0 leading-relaxed">
                    Aproxime ou escaneie. O cliente acessa sua página de avaliação.
                  </p>
                  <div className="pt-2">
                    <button
                      type="button"
                      onClick={() => openInterestModal('Placa NFC Google (R$ 129,00)')}
                      className="alf-lp-btn-blue"
                    >
                      <span>Quero minha placa — R$ 129</span>
                      <ArrowRight className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              )}

              {activeScene === 3 && (
                <div className="alf-active-scene-copy alf-gsap-scene space-y-6">
                  <span className="alf-lp-kicker text-[#2563EB] block">
                    BIO SITE PROFISSIONAL
                  </span>
                  <h1 className="alf-lp-h1">
                    Uma apresentação profissional. Em um único link.
                  </h1>
                  <p className="text-base sm:text-lg text-zinc-400 max-w-md mx-auto lg:mx-0 leading-relaxed">
                    Mostre sua marca, serviços e canais de contato.
                  </p>
                  <div className="pt-2">
                    <a href="#modelos" className="alf-lp-btn-primary">
                      <span>Explorar modelos</span>
                      <ArrowRight className="w-4 h-4" />
                    </a>
                  </div>
                </div>
              )}

              {activeScene === 4 && (
                <div className="alf-active-scene-copy alf-gsap-scene space-y-6">
                  <span className="alf-lp-kicker text-[#2563EB] block">
                    ESCOLHA SUA SOLUÇÃO
                  </span>
                  <h1 className="alf-lp-h1">
                    Sua próxima conexão começa aqui.
                  </h1>
                  <p className="text-base text-zinc-400 max-w-md mx-auto lg:mx-0 leading-relaxed">
                    Tecnologia pronta para conectar o atendimento presencial à presença digital da sua empresa.
                  </p>
                  <div className="pt-1">
                    <button
                      type="button"
                      onClick={() => openInterestModal('Estrutura Digital Completa (Sob consulta)')}
                      className="text-xs sm:text-sm text-zinc-400 hover:text-white underline underline-offset-4 transition cursor-pointer"
                    >
                      Precisa de uma solução personalizada? Sob consulta →
                    </button>
                  </div>
                </div>
              )}
            </div>

            {/* COLUNA DIREITA: PRODUTO REAL EM DESTAQUE NO FUNDO #050505 */}
            <div className="lg:col-span-7 flex items-center justify-center">
              {/* CENA 1 — VÍDEO ORIGINAL DO CARTÃO NFC ALF */}
              {activeScene === 1 && (
                <div className="alf-active-scene-visual alf-gsap-scene w-full max-w-2xl mx-auto">
                  <div className="relative rounded-3xl overflow-hidden bg-[#050505]">
                    <video
                      ref={cardVideoRef}
                      src="/assets/aistudio/gemini_generated_video_0074c1e0_5e58e090.mp4"
                      poster={ALF_CARD_VIDEO_POSTER_URI}
                      autoPlay
                      muted
                      loop
                      playsInline
                      preload="auto"
                      disablePictureInPicture
                      controlsList="nodownload nofullscreen noremoteplayback"
                      className="w-full h-auto max-h-[440px] object-contain mx-auto pointer-events-none select-none"
                    />
                  </div>
                </div>
              )}

              {/* CENA 2 — FOTOGRAFIA ORIGINAL DA PLACA NFC GOOGLE (SEM ALTERAR O PRODUTO) */}
              {activeScene === 2 && (
                <div className="alf-active-scene-visual alf-gsap-scene w-full max-w-md mx-auto flex flex-col items-center">
                  <div className="rounded-3xl p-2 sm:p-4 bg-[#050505]">
                    <img
                      src="/assets/aistudio/palca_empresa_01_a118061f.png"
                      alt="Placa NFC Google ALF Automação"
                      loading="eager"
                      className="w-full max-w-[380px] h-auto object-contain mx-auto rounded-2xl shadow-2xl"
                    />
                  </div>
                </div>
              )}

              {/* CENA 3 — BIO SITE REAL EXIBIDO EM UM SMARTPHONE CRIADO COM HTML/CSS (SEM ROTAÇÃO) */}
              {activeScene === 3 && (
                <div className="alf-active-scene-visual alf-gsap-scene w-full flex flex-col items-center">
                  <div className="alf-phone-frame">
                    <div className="alf-phone-notch">
                      <div className="alf-phone-notch-lens" />
                    </div>

                    {/* Interface Real Preservada do Bio Site dentro do Smartphone HTML/CSS */}
                    <div className="alf-phone-screen text-left">
                      {/* Barra de Status do Smartphone */}
                      <div className="px-5 pt-2 pb-1.5 flex items-center justify-between text-[10px] font-semibold text-white/90 bg-[#061318]">
                        <span>9:41</span>
                        <div className="flex items-center gap-1">
                          <span className="inline-block w-2.5 h-2 rounded-xs bg-white/80" />
                          <span className="inline-block w-3.5 h-2 rounded-xs bg-white" />
                        </div>
                      </div>

                      {/* Cabeçalho Dra. Helena Vasconcelos • Prime Med (Preservado da Captura Real) */}
                      <div className="px-3.5 py-2.5 flex items-center gap-2.5 bg-[#061318] border-b border-white/10">
                        <img
                          src={medicalMockup.config.logoUrl}
                          alt="Prime Med"
                          className="w-10 h-10 rounded-full object-cover border border-teal-400/40 shrink-0"
                        />
                        <div className="min-w-0 flex-1">
                          <div className="text-[11px] font-bold text-white leading-tight truncate">
                            Dra. Helena Vasconcelos
