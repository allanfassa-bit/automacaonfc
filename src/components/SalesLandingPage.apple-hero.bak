                        </div>
                      ) : (
                        /* Tela Cena 01, 03 e 04: Representação Fiel do Bio Site Demonstrativo Selecionado (Médico, Bio Pessoal ou Corretor) */
                        <div className="alf-screen-scene1 alf-screen-scene3 my-auto py-3 space-y-3 text-left">
                          <div className="rounded-2xl bg-[#101D32] border border-white/10 overflow-hidden">
