                                />
                                <div className="absolute inset-0 bg-gradient-to-t from-[#101D32] via-[#101D32]/30 to-transparent" />
                                <span className="absolute top-2 right-2 px-2 py-0.5 rounded-full bg-black/65 backdrop-blur-xs border border-white/15 text-[10px] font-semibold text-white">
                                  {heroSelectedMockup.category}
                                </span>
                              </div>
                            )}

                            <div className="p-3.5 space-y-3">
                              <div className="flex items-center gap-3">
                                {heroSelectedMockup.config.logoUrl ? (
