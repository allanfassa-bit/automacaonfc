              Explore modelos profissionais para diferentes segmentos.
            </p>
          </div>

          {/* Galeria Visual Sofisticada com os 6 Modelos Reais */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
            {publicShowcaseModels.map((tmpl) => {
              const previewImage = tmpl.config.logoUrl || '/alf-logo.jpg';
              const coverThumb = tmpl.config.coverImageUrl;

              return (
                <div
                  key={tmpl.id}
                  className="alf-lp-card overflow-hidden flex flex-col justify-between text-left"
                >
                  {/* Preview Real do Modelo */}
                  <div>
                    <div className="bg-[#0B1220] p-5 border-b border-[#E5E7EB] relative overflow-hidden">
                      {coverThumb && (
                        <img
                          src={coverThumb}
                          alt={tmpl.title}
                          className="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none"
                        />
                      )}
                      <div className="relative z-10 flex items-center justify-between gap-2 mb-4">
                        <span className="text-xs font-semibold text-white bg-white/15 backdrop-blur-xs px-3 py-1 rounded-full">
                          {tmpl.category}
                        </span>
                        <span className="text-base" aria-hidden="true">
                          {tmpl.emoji}
                        </span>
                      </div>

                      <div className="relative z-10 rounded-xl bg-[#101D32]/95 backdrop-blur-xs border border-white/15 p-3.5 flex items-center gap-3.5">
                        <img
                          src={previewImage}
                          alt={tmpl.title}
                          className="w-13 h-13 rounded-xl object-cover border border-white/20 shrink-0 bg-black"
                        />
                        <div className="space-y-0.5 min-w-0">
                          <h3 className="text-sm sm:text-base font-semibold text-white leading-snug truncate">
                            {tmpl.config.companyName || tmpl.title}
                          </h3>
                          <span className="text-xs text-slate-300 block truncate">
                            {tmpl.config.personRole || tmpl.badge}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div className="p-5 sm:p-6 pb-3 sm:pb-4">
                      <p className="text-sm text-[#667085] leading-relaxed">
                        {tmpl.config.bio}
                      </p>
                    </div>
