          SEÇÃO 04 — COMO FUNCIONA (3 ETAPAS OBJETIVAS)
         ====================================================================== */}
      <section id="como-funciona" className="alf-lp-section bg-[#FAF9F6] border-t border-[#E5E7EB]">
        <div className="alf-lp-container space-y-10 sm:space-y-12">
          <div className="max-w-2xl space-y-3 text-left">
            <span className="alf-lp-kicker text-[#2563EB] block">
              JORNADA SIMPLES
            </span>
            <h2 className="alf-lp-h2 text-[#172033]">
              Escolha. Personalize. Compartilhe.
            </h2>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 text-left">
            <div className="alf-lp-card p-6 sm:p-7 space-y-3">
              <span className="text-xs font-bold text-[#2563EB] tracking-wider uppercase block">
                Etapa 01
              </span>
              <h3 className="alf-lp-h3 text-[#172033]">
                Escolha sua solução.
              </h3>
              <p className="text-sm text-[#667085] leading-relaxed">
                Defina entre a Placa NFC Google para o seu estabelecimento ou um modelo profissional de Bio Site com cartão NFC.
              </p>
            </div>

            <div className="alf-lp-card p-6 sm:p-7 space-y-3">
              <span className="text-xs font-bold text-[#2563EB] tracking-wider uppercase block">
                Etapa 02
              </span>
              <h3 className="alf-lp-h3 text-[#172033]">
                Receba sua placa ou personalize seu Bio Site.
              </h3>
              <p className="text-sm text-[#667085] leading-relaxed">
                Acesse seu portal individual para configurar cor, logotipo, imagem principal, até 4 fotos de produtos, Instagram e WhatsApp.
              </p>
            </div>

            <div className="alf-lp-card p-6 sm:p-7 space-y-3">
              <span className="text-xs font-bold text-[#2563EB] tracking-wider uppercase block">
                Etapa 03
              </span>
              <h3 className="alf-lp-h3 text-[#172033]">
                Compartilhe com seus clientes.
              </h3>
              <p className="text-sm text-[#667085] leading-relaxed">
                Conecte clientes presencialmente por aproximação NFC e QR Code ou envie seu link direto no atendimento diário.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ======================================================================
          SEÇÃO 05 — CREDIBILIDADE + CHAMADA SECUNDÁRIA (ESTRUTURA COMPLETA)
         ====================================================================== */}
      <section id="credibilidade" className="alf-lp-section bg-white border-t border-[#E5E7EB]">
        <div className="alf-lp-container space-y-10 sm:space-y-12">
          <div className="max-w-2xl space-y-3 text-left">
            <span className="alf-lp-kicker text-[#2563EB] block">
              ESTRUTURA REAL
            </span>
            <h2 className="alf-lp-h2 text-[#172033]">
              Tecnologia prática para negócios reais.
            </h2>
          </div>

          {/* 3 Blocos Visuais de Evidências Reais */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 text-left">
            <div className="alf-lp-card p-6 sm:p-7 space-y-4">
              <div className="w-11 h-11 rounded-xl bg-[#FAF9F6] border border-[#E5E7EB] flex items-center justify-center text-[#101D32]">
                <QrCode className="w-5 h-5 text-[#2563EB]" />
              </div>
              <h3 className="text-lg font-bold text-[#172033]">
                Placas e cartões físicos
              </h3>
              <p className="text-sm text-[#667085] leading-relaxed">
                Hardware com chip NFC e QR Code integrado para uso imediato em balcões, consultórios, mesas e reuniões comerciais.
              </p>
            </div>

            <div className="alf-lp-card p-6 sm:p-7 space-y-4">
              <div className="w-11 h-11 rounded-xl bg-[#FAF9F6] border border-[#E5E7EB] flex items-center justify-center text-[#101D32]">
                <Layers className="w-5 h-5 text-[#2563EB]" />
              </div>
              <h3 className="text-lg font-bold text-[#172033]">
                Demonstrações funcionais
              </h3>
              <p className="text-sm text-[#667085] leading-relaxed">
                Você visualiza na prática como o modelo funciona antes de contratar, com estrutura validada para leitura rápida no celular.
              </p>
            </div>

            <div className="alf-lp-card p-6 sm:p-7 space-y-4">
              <div className="w-11 h-11 rounded-xl bg-[#FAF9F6] border border-[#E5E7EB] flex items-center justify-center text-[#101D32]">
                <Sliders className="w-5 h-5 text-[#2563EB]" />
              </div>
              <h3 className="text-lg font-bold text-[#172033]">
                Portal de personalização
              </h3>
              <p className="text-sm text-[#667085] leading-relaxed">
                Acesso individual por login e senha para gerenciar os dados essenciais da sua marca mantendo o padrão visual do modelo.
              </p>
            </div>
          </div>

          {/* Chamada Secundária: Solução 03 — Estrutura Digital Completa (Sob consulta) */}
          <div className="rounded-3xl bg-[#FAF9F6] border border-[#E5E7EB] p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6 text-left">
            <div className="max-w-2xl space-y-2">
              <span className="alf-lp-kicker text-[#667085] block">
                PROJETOS PERSONALIZADOS • SOB CONSULTA
              </span>
              <h3 className="alf-lp-h3 text-[#172033]">
                Precisa de uma estrutura digital completa?
              </h3>
              <p className="text-sm sm:text-base text-[#667085] leading-relaxed">
                Desenvolvemos projetos sob medida com site profissional, presença digital e gerenciamento do Perfil da Empresa no Google.
              </p>
            </div>

            <div className="shrink-0">
              <button
                type="button"
                onClick={() => openInterestModal('Estrutura Digital Completa (Sob consulta)')}
                className="alf-lp-btn-outline w-full sm:w-auto"
              >
                <span>Solicitar proposta personalizada</span>
                <ArrowRight className="w-4 h-4" />
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* ======================================================================
          SEÇÃO 06 — CTA FINAL + RODAPÉ COMPACTO
         ====================================================================== */}
      <section className="alf-lp-section bg-[#101D32] text-white">
        <div className="alf-lp-container">
          <div className="max-w-3xl mx-auto text-center space-y-6">
            <h2 className="alf-lp-h2 text-white">
              Pronto para dar o próximo passo?
            </h2>
            <p className="text-sm sm:text-lg text-slate-300">
              Escolha uma solução pronta ou converse com nossa equipe.
            </p>

            <div className="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5 sm:gap-4">
              <button
                type="button"
                onClick={() => openInterestModal('Atendimento Comercial ALF Automação')}
                className="alf-lp-btn-blue w-full sm:w-auto"
              >
                <MessageCircle className="w-4 h-4" />
                <span>Falar com a ALF Automação</span>
              </button>

              <a href="#modelos" className="alf-lp-btn-ghost-dark w-full sm:w-auto">
                <span>Explorar Bio Sites</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* RODAPÉ COMPACTO COM ACESSO OCULTO DE 5 CLIQUES PRESERVADO */}
      <footer className="bg-[#0B1220] border-t border-white/10 py-10 text-slate-400 text-xs">
        <div className="alf-lp-container flex flex-col sm:flex-row items-center justify-between gap-6">
          <div
            onClick={handleSecretFooterLogoClick}
            className="alf-lp-brand-lockup select-none cursor-default"
            title="ALF Automação"
          >
            <div className="alf-lp-brand-emblem">
              <img
                src={ALF_LOGO_DATA_URI}
                alt="ALF Automação"
                className="w-full h-full object-contain scale-105"
              />
            </div>
            <div className="text-left pr-1">
              <div className="flex items-center gap-1.5">
                <span className="font-extrabold text-white text-sm tracking-tight uppercase">
                  ALF
                </span>
                <span className="font-extrabold text-blue-400 text-sm tracking-tight uppercase">
                  AUTOMAÇÃO
                </span>
              </div>
              <span className="text-[11px] text-slate-400 block mt-0.5">
                © 2026 Todos os direitos reservados.
              </span>
            </div>
          </div>

          <div className="flex flex-wrap items-center justify-center gap-5">
            <a
              href="https://wa.me/5514981304973"
              target="_blank"
              rel="noreferrer"
              className="text-slate-300 hover:text-white flex items-center gap-1.5 transition"
            >
              <MessageCircle className="w-3.5 h-3.5 text-blue-400" />
              <span>WhatsApp</span>
            </a>

            <a
              href="https://www.instagram.com/alfautomation?xtok=MWY4a3VpcTBrOWI4Yw=="
              target="_blank"
              rel="noreferrer"
              className="text-slate-300 hover:text-white flex items-center gap-1.5 transition"
            >
              <Instagram className="w-3.5 h-3.5 text-slate-300" />
              <span>Instagram</span>
            </a>

            <button
              type="button"
              onClick={() => setIsPrivacyModalOpen(true)}
              className="text-slate-400 hover:text-white underline cursor-pointer transition"
            >
              Política de Privacidade (LGPD)
            </button>
          </div>
        </div>
      </footer>

      {/* MODAL DE POLÍTICA DE PRIVACIDADE (PRESERVADO) */}
      {isPrivacyModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md">
          <div className="bg-[#0B1220] border border-white/15 rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl relative text-left max-h-[85vh] overflow-y-auto space-y-4 text-slate-200">
            <div className="flex items-center justify-between border-b border-white/10 pb-4">
              <div className="flex items-center gap-2.5">
                <Shield className="w-5 h-5 text-blue-400" />
                <h3 className="text-base sm:text-lg font-bold text-white">
                  Política de Privacidade &amp; Proteção de Dados (LGPD)
                </h3>
              </div>
              <button
                type="button"
                onClick={() => setIsPrivacyModalOpen(false)}
                className="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 flex items-center justify-center font-bold text-xs cursor-pointer transition shrink-0"
                aria-label="Fechar Política de Privacidade"
              >
                ✕
              </button>
            </div>

            <div className="space-y-3 text-xs text-slate-300 leading-relaxed">
              <p>
                A <strong>ALF Automação</strong> atua em conformidade com a Lei Geral de Proteção de Dados Pessoais (Lei nº 13.709/2018 — LGPD).
              </p>
              <p>
                <strong>1. Coleta de Informações:</strong> Coletamos apenas os dados fornecidos voluntariamente no formulário comercial (nome, e-mail, telefone/WhatsApp e empresa) exclusivamente para retorno e atendimento solicitado.
              </p>
              <p>
                <strong>2. Segurança:</strong> Não comercializamos nem cedemos dados a terceiros.
              </p>
            </div>

            <div className="pt-3 border-t border-white/10 flex justify-end">
              <button
                type="button"
                onClick={() => setIsPrivacyModalOpen(false)}
                className="alf-lp-btn-blue !py-2 !px-5 text-xs"
              >
                Fechar
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL COMERCIAL DE SOLICITAÇÃO / CONTRATAÇÃO (PRESERVADO) */}
      {isInterestModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md">
          <div className="bg-[#0B1220] border border-white/15 rounded-3xl max-w-md w-full p-5 sm:p-8 shadow-2xl relative text-left text-white max-h-[92vh] overflow-y-auto">
            <button
              type="button"
              onClick={() => setIsInterestModalOpen(false)}
              className="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 flex items-center justify-center font-bold text-xs cursor-pointer transition"
              aria-label="Fechar"
            >
              ✕
            </button>

            {!interestSubmittedSuccess ? (
              <form onSubmit={handleInterestSubmit} className="space-y-4">
                <div className="flex items-center gap-3 pr-8">
                  <div className="alf-lp-brand-emblem">
                    <img
                      src={ALF_LOGO_DATA_URI}
                      alt="ALF Automação"
                      className="w-full h-full object-contain"
                    />
                  </div>
                  <div>
                    <span className="alf-lp-kicker text-blue-400 block">
                      SOLICITAÇÃO COMERCIAL
                    </span>
                    <h3 className="text-base sm:text-lg font-bold text-white mt-0.5">
                      Iniciar atendimento
                    </h3>
                  </div>
                </div>

                <div className="bg-[#101D32] border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-slate-200">
                  Opção selecionada: <strong className="text-white">{interestTopic}</strong>
                </div>

                {/* Honeypot anti-bot */}
                <input
                  type="text"
                  name="company_website_url_trap"
                  tabIndex={-1}
                  autoComplete="off"
                  value={honeypotWebsite}
                  onChange={(e) => setHoneypotWebsite(e.target.value)}
                  className="hidden"
                />

                <div className="space-y-3">
                  <div>
                    <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                      Nome completo *
                    </label>
                    <input
                      type="text"
                      required
                      value={interestName}
                      onChange={(e) => setInterestName(e.target.value)}
                      placeholder="Seu nome"
                      className="w-full bg-[#101D32] border border-white/15 focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                    />
                  </div>

                  <div>
                    <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                      E-mail *
                    </label>
                    <input
                      type="email"
                      required
                      value={interestEmail}
                      onChange={(e) => setInterestEmail(e.target.value)}
                      placeholder="contato@empresa.com.br"
                      className="w-full bg-[#101D32] border border-white/15 focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                    />
                  </div>

                  <div>
                    <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                      WhatsApp (com DDD) *
                    </label>
                    <input
                      type="tel"
                      required
                      value={interestPhone}
                      onChange={(e) => setInterestPhone(e.target.value)}
                      placeholder="(14) 99999-9999"
                      className="w-full bg-[#101D32] border border-white/15 focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                    />
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <div>
                      <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                        Empresa
                      </label>
                      <input
                        type="text"
                        value={interestCompany}
                        onChange={(e) => setInterestCompany(e.target.value)}
                        placeholder="Nome do negócio"
                        className="w-full bg-[#101D32] border border-white/15 focus:border-[#2563EB] rounded-xl px-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                        Segmento
                      </label>
                      <input
                        type="text"
                        value={interestNicheInput}
                        onChange={(e) => setInterestNicheInput(e.target.value)}
                        placeholder="Ex: Clínica, Café..."
                        className="w-full bg-[#101D32] border border-white/15 focus:border-[#2563EB] rounded-xl px-3 py-2 text-xs text-white placeholder-slate-400 focus:outline-hidden transition"
                      />
                    </div>
                  </div>
                </div>

                {interestError && (
                  <div className="p-3 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-200 text-xs font-medium">
                    {interestError}
                  </div>
                )}

                <button
                  type="submit"
                  disabled={isSubmittingInterest}
                  className="alf-lp-btn-blue w-full justify-center disabled:opacity-50"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>
                    {isSubmittingInterest ? 'Enviando...' : 'Continuar solicitação'}
                  </span>
                </button>

                <div className="pt-1 text-center">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automação! Tenho interesse em: ${interestTopic}.`
                    )}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="text-xs text-slate-300 hover:text-white inline-flex items-center gap-1.5 transition"
                  >
                    <MessageCircle className="w-3.5 h-3.5 text-blue-400" />
                    <span>Prefiro falar diretamente no WhatsApp</span>
                  </a>
                </div>
              </form>
            ) : (
              <div className="text-center space-y-4 py-3">
                <div className="w-12 h-12 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-6 h-6" />
                </div>
                <div className="space-y-1">
                  <h4 className="text-lg font-bold text-white">
                    Solicitação registrada, {interestName.split(' ')[0]}!
                  </h4>
                  <p className="text-xs text-slate-300 leading-relaxed">
                    Recebemos seu contato para <strong>{interestTopic}</strong>.
                  </p>
                </div>

                <div className="pt-2 space-y-2.5">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automação! Me chamo ${interestName}. Registrei meu interesse no site sobre: ${interestTopic}.`
                    )}`}
                    target="_blank"
                    rel="noreferrer"
                    className="alf-lp-btn-blue w-full justify-center"
                  >
                    <MessageCircle className="w-4 h-4" />
                    <span>Concluir pelo WhatsApp</span>
                  </a>

                  <button
                    type="button"
                    onClick={() => setIsInterestModalOpen(false)}
                    className="alf-lp-btn-ghost-dark w-full justify-center text-xs"
                  >
                    Fechar
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* MODAL DE DEMONSTRAÇÃO INTERATIVA DOS BIO SITES — 100% ADAPTADO PARA SMARTPHONES */}
      {fullscreenEmulationMockup && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-2xl flex flex-col overflow-hidden"
        >
          <div className="w-full bg-[#0B1220] border-b border-white/10 px-3 sm:px-5 py-2.5 shrink-0 z-20 space-y-2">
            <div className="flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 min-w-0 flex-1">
                <span className="text-base sm:text-xl shrink-0">{fullscreenEmulationMockup.emoji}</span>
                <div className="text-left min-w-0 flex-1">
                  <span className="text-[10px] sm:text-[11px] font-medium text-blue-400 block truncate">
                    Demonstração — {fullscreenEmulationMockup.category}
                  </span>
                  <strong className="text-xs sm:text-sm font-semibold text-white block truncate">
                    {fullscreenEmulationMockup.config.companyName || fullscreenEmulationMockup.title}
                  </strong>
                </div>
              </div>

              <div className="hidden xl:flex items-center gap-1.5 bg-[#101D32] p-1 rounded-xl border border-white/10">
                {publicShowcaseModels.map((m) => {
                  const active = m.id === fullscreenEmulationMockup.id;
                  return (
                    <button
                      key={m.id}
                      type="button"
                      onClick={() => {
                        setFullscreenEmulationMockup(m);
                        setSelectedShowcaseMockupId(m.id);
                      }}
                      className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-1 ${
                        active
                          ? 'bg-[#2563EB] text-white'
                          : 'text-slate-300 hover:text-white hover:bg-white/5'
                      }`}
                    >
                      <span>{m.emoji}</span>
                      <span>{m.category.split(' ')[0]}</span>
                    </button>
                  );
                })}
              </div>

              <div className="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                <button
                  type="button"
                  onClick={() => {
                    const chosen = fullscreenEmulationMockup;
                    setFullscreenEmulationMockup(null);
                    openInterestModal(
                      `Bio Site + Cartão NFC — Modelo: ${chosen.category} (${chosen.title})`
                    );
                  }}
                  className="alf-lp-btn-blue !py-1.5 sm:!py-2 !px-2.5 sm:!px-4 !text-[11px] sm:!text-xs !rounded-lg sm:!rounded-xl whitespace-nowrap"
                >
                  <span>Quero este modelo</span>
                </button>

                <button
                  type="button"
                  onClick={() => setFullscreenEmulationMockup(null)}
                  className="px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-lg sm:rounded-xl bg-white/10 hover:bg-white/15 text-white font-medium text-[11px] sm:text-xs flex items-center gap-1 border border-white/15 cursor-pointer transition shrink-0"
                  aria-label="Fechar demonstração"
                >
                  <X className="w-3.5 h-3.5 sm:w-4 sm:h-4" />
                  <span className="hidden sm:inline">Fechar</span>
                </button>
              </div>
            </div>

            {/* Seletor Rápido Mobile/Tablet dentro da Demonstração */}
            <div className="xl:hidden flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
              {publicShowcaseModels.map((m) => {
                const active = m.id === fullscreenEmulationMockup.id;
                return (
                  <button
                    key={m.id}
                    type="button"
                    onClick={() => {
                      setFullscreenEmulationMockup(m);
                      setSelectedShowcaseMockupId(m.id);
                    }}
                    className={`px-2.5 py-1 rounded-lg text-[11px] font-medium whitespace-nowrap transition cursor-pointer flex items-center gap-1 shrink-0 ${
                      active
                        ? 'bg-[#2563EB] text-white'
                        : 'bg-[#101D32] text-slate-300 border border-white/10'
                    }`}
                  >
                    <span>{m.emoji}</span>
                    <span>{m.category}</span>
                  </button>
                );
              })}
            </div>
          </div>

          <div className="flex-1 overflow-y-auto bg-black">
            <MiniSiteViewer
              key={`fullscreen-${fullscreenEmulationMockup.id}`}
              standalone={true}
              config={fullscreenEmulationMockup.config}
              leadId={fullscreenEmulationMockup.id}
            />
          </div>
        </div>
      )}
    </div>
  );
};
