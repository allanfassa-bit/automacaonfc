                                    src={heroSelectedMockup.config.logoUrl}
                                    alt={heroSelectedMockup.title}
                                    className="w-11 h-11 rounded-xl object-cover border border-white/20 shrink-0 shadow-sm"
                                  />
                                ) : (
                                  <div className="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center text-base shrink-0">
                                    {heroSelectedMockup.emoji}
                                  </div>
                                )}
