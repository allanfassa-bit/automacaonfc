                                  <span className="truncate">Ver demonstração</span>
                                </button>
                                <a
                                  href="#modelos"
                                  className="py-2 px-3 rounded-lg bg-white/10 hover:bg-white/15 text-white text-xs font-medium flex items-center justify-center transition truncate"
                                >
                                  Outros modelos
                                </a>
                              </div>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* Rodapé de Conversão da Composição (Cena 04) */}
                      <div className="alf-stage-final-cta pt-2.5 border-t border-white/10 flex flex-wrap items-center justify-between gap-2">
                        <button
                          type="button"
                          onClick={() => openInterestModal('Placa NFC Google (R$ 129,00)')}
