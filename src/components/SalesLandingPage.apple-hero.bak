                    <button
                      type="button"
                      onClick={() => {
                        setSelectedShowcaseMockupId(tmpl.id);
                        setFullscreenEmulationMockup(tmpl);
                      }}
                      className="alf-lp-btn-outline !py-3 !px-4 text-xs w-full"
                    >
                      <Eye className="w-4 h-4 text-[#172033] shrink-0" />
                      <span>Ver demonstração</span>
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        openInterestModal(
                          `Bio Site + Cartão NFC — Modelo: ${tmpl.category} (${tmpl.title})`
