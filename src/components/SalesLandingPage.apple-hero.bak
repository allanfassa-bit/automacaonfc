                      {/* Topo do Smartphone + Seletor Rápido das 3 Opções */}
                      <div className="space-y-2.5 pb-3 border-b border-white/10">
                        <div className="flex items-center justify-between gap-2">
                          <span className="text-[11px] font-semibold text-slate-300">
                            {activeScene === 2
                              ? 'Acesso à Avaliação Google'
                              : 'Bio Site Demonstrativo ALF'}
                          </span>
                          <div className="w-10 h-1.5 rounded-full bg-white/15 shrink-0" />
