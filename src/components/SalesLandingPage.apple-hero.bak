                {/* Representação visual fiel do Bio Site + Cartão NFC */}
                <div className="rounded-2xl bg-[#101D32] p-5 sm:p-6 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border border-[#172033]">
                  <div className="flex items-center gap-3.5 sm:gap-4">
                    <div className="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#0B1220] border border-white/15 p-2 flex items-center justify-center shrink-0">
                      <img
