import React, { useState, useMemo, useEffect, useRef } from 'react';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import {
  Smartphone,
  QrCode,
  Shield,
  CheckCircle2,
  ArrowRight,
  MessageCircle,
  Instagram,
  Wifi,
  Eye,
  X,
  Menu,
  Sliders,
  Layers
} from 'lucide-react';
import {
  ALF_LOGO_DATA_URI,
  READY_MINISITE_MOCKUPS,
  ReadyMockupTemplate
} from '../utils/readyMiniSiteMockups';
import { MiniSiteViewer } from './MiniSiteViewer';
import '../styles/salesLanding.css';

gsap.registerPlugin(ScrollTrigger);

export interface InterestLeadPayload {
  name: string;
  email: string;
  phone: string;
  companyName: string;
  niche: string;
  interestType: string;
}

export interface SalesLandingPageProps {
  onOpenLogin: (suggestedTab?: string) => void;
  onExploreDemo?: () => void;
  initialNiche?: string;
  onRegisterInterest?: (payload: InterestLeadPayload) => Promise<void> | void;
  isAdminAuthenticated?: boolean;
  onGoToAdminPanel?: () => void;
}

const SHOWCASE_PUBLIC_MODEL_IDS = [
  'bio_medica',
  'modelo_bio_pessoal_demo',
  'modelo_corretor_demo',
  'cafe',
  'bio_estetica_facial',
  'hamburgueria'
];

const HERO_BIO_DEMO_TABS: Array<{ id: string; label: string }> = [
  { id: 'bio_medica', label: 'Médico' },
  { id: 'modelo_bio_pessoal_demo', label: 'Bio Pessoal' },
  { id: 'modelo_corretor_demo', label: 'Corretor' }
];

export const SalesLandingPage: React.FC<SalesLandingPageProps> = ({
  onOpenLogin,
  initialNiche,
  onRegisterInterest,
  isAdminAuthenticated,
  onGoToAdminPanel
}) => {
  const [selectedShowcaseMockupId, setSelectedShowcaseMockupId] = useState<string>(() => {
    if (initialNiche) {
      const matched = READY_MINISITE_MOCKUPS.find(
        (m) =>
          SHOWCASE_PUBLIC_MODEL_IDS.includes(m.id) &&
          (m.id.toLowerCase().includes(initialNiche.toLowerCase()) ||
            m.category.toLowerCase().includes(initialNiche.toLowerCase()))
      );
      if (matched) return matched.id;
    }
    return 'bio_medica';
  });

  const [activeScene, setActiveScene] = useState<1 | 2 | 3 | 4>(1);
  const [prefersReducedMotion, setPrefersReducedMotion] = useState<boolean>(false);
  const [fullscreenEmulationMockup, setFullscreenEmulationMockup] = useState<ReadyMockupTemplate | null>(null);
  const [isHeaderScrolled, setIsHeaderScrolled] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isPrivacyModalOpen, setIsPrivacyModalOpen] = useState(false);

  // Public Interest Capture Modal State (preserves honeypot & rate limiting)
  const [isInterestModalOpen, setIsInterestModalOpen] = useState(false);
  const [interestTopic, setInterestTopic] = useState<string>('Bio Site + Cartão NFC (R$ 1.199,00)');
  const [interestName, setInterestName] = useState('');
  const [interestEmail, setInterestEmail] = useState('');
  const [interestPhone, setInterestPhone] = useState('');
  const [interestCompany, setInterestCompany] = useState('');
  const [interestNicheInput, setInterestNicheInput] = useState('');
  const [honeypotWebsite, setHoneypotWebsite] = useState('');
  const [isSubmittingInterest, setIsSubmittingInterest] = useState(false);
  const [interestSubmittedSuccess, setInterestSubmittedSuccess] = useState(false);
  const [interestError, setInterestError] = useState('');
  const [lastSubmitTimestamp, setLastSubmitTimestamp] = useState<number>(0);

  // Refs for GSAP Hero Storytelling & Secret Footer Login
  const rootRef = useRef<HTMLDivElement | null>(null);
  const heroSectionRef = useRef<HTMLElement | null>(null);
  const secretLogoClicksRef = useRef<{ count: number; lastClick: number }>({ count: 0, lastClick: 0 });

  const openInterestModal = (topic?: string) => {
    if (topic) setInterestTopic(topic);
    setInterestSubmittedSuccess(false);
    setInterestError('');
    setIsInterestModalOpen(true);
  };

  const handleSecretFooterLogoClick = () => {
    const now = Date.now();
    if (now - secretLogoClicksRef.current.lastClick > 2500) {
      secretLogoClicksRef.current.count = 1;
    } else {
      secretLogoClicksRef.current.count += 1;
    }
    secretLogoClicksRef.current.lastClick = now;
    if (secretLogoClicksRef.current.count >= 5) {
      secretLogoClicksRef.current.count = 0;
      onOpenLogin();
    }
  };

  const handleInterestSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setInterestError('');

    if (honeypotWebsite.trim().length > 0) {
      setInterestSubmittedSuccess(true);
      return;
    }

    const now = Date.now();
    if (now - lastSubmitTimestamp < 30000) {
      setInterestError('Aguarde alguns segundos antes de enviar uma nova solicitação.');
      return;
    }

    const cleanName = interestName.trim();
    const cleanEmail = interestEmail.trim().toLowerCase();
    const cleanPhone = interestPhone.replace(/\D/g, '');
    const cleanCompany = interestCompany.trim() || cleanName;

    if (!cleanName || cleanName.length < 2) {
      setInterestError('Por favor, informe seu nome completo.');
      return;
    }
    if (!cleanEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      setInterestError('Por favor, informe um e-mail válido para contato.');
      return;
    }
    if (!cleanPhone || cleanPhone.length < 10) {
      setInterestError('Por favor, informe seu WhatsApp ou telefone com DDD.');
      return;
    }

    setIsSubmittingInterest(true);
    try {
      if (onRegisterInterest) {
        await onRegisterInterest({
          name: cleanName,
          email: cleanEmail,
          phone: cleanPhone,
          companyName: cleanCompany,
          niche: interestNicheInput.trim() || 'Não informado',
          interestType: interestTopic
        });
      }
      setLastSubmitTimestamp(Date.now());
      setInterestSubmittedSuccess(true);
    } catch (_) {
      setInterestSubmittedSuccess(true);
    } finally {
      setIsSubmittingInterest(false);
    }
  };

  const publicShowcaseModels: ReadyMockupTemplate[] = useMemo(() => {
    return SHOWCASE_PUBLIC_MODEL_IDS.map((id) =>
      READY_MINISITE_MOCKUPS.find((m) => m.id === id)
    ).filter((m): m is ReadyMockupTemplate => Boolean(m));
  }, []);

  // Ensure the Hero smartphone demo defaults to one of the 3 Hero Demo models (Médico, Bio Pessoal, Corretor)
  const heroSelectedMockup: ReadyMockupTemplate = useMemo(() => {
    const heroMatch = publicShowcaseModels.find((m) => m.id === selectedShowcaseMockupId);
    if (heroMatch) return heroMatch;
    return (
      publicShowcaseModels.find((m) => m.id === 'bio_medica') ||
      publicShowcaseModels[0] ||
      READY_MINISITE_MOCKUPS[0]
    );
  }, [publicShowcaseModels, selectedShowcaseMockupId]);

  useEffect(() => {
    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      setIsHeaderScrolled(y > 16);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  // GSAP + ScrollTrigger 4-Scene Hero Storytelling with matchMedia & prefers-reduced-motion
  useEffect(() => {
    if (typeof window === 'undefined' || !rootRef.current || !heroSectionRef.current) return;

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    setPrefersReducedMotion(motionQuery.matches);

    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();

      // Desktop Storytelling with controlled scrub & short pin
      mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
        gsap.fromTo(
          '.alf-hero-intro',
          { opacity: 0, y: 18 },
          { opacity: 1, y: 0, duration: 0.65, stagger: 0.08, ease: 'power2.out' }
        );

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: heroSectionRef.current,
            start: 'top top+=76',
            end: '+=960',
            pin: true,
            scrub: 0.5,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const p = self.progress;
              if (p < 0.24) {
                setActiveScene(1);
              } else if (p < 0.54) {
                setActiveScene(2);
              } else if (p < 0.82) {
                setActiveScene(3);
              } else {
                setActiveScene(4);
              }
            }
          }
        });

        // CENA 02: Smartphone approaches Placa NFC + discreet pulse + Google review screen
        tl.to(
          '.alf-stage-phone',
          { x: -28, y: -6, scale: 1.03, duration: 1, ease: 'power2.inOut' },
          'scene2'
        )
          .to(
            '.alf-stage-plaque',
            { x: 14, scale: 1.04, duration: 1, ease: 'power2.inOut' },
            'scene2'
          )
          .fromTo(
            '.alf-stage-nfc-pulse',
            { opacity: 0, scale: 0.75 },
            { opacity: 1, scale: 1.18, duration: 0.9, ease: 'power2.out' },
            'scene2+=0.1'
          )
          .to(
            '.alf-screen-scene1',
            { opacity: 0, duration: 0.45, ease: 'power1.out' },
            'scene2+=0.15'
          )
          .fromTo(
            '.alf-screen-scene2',
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' },
            'scene2+=0.25'
          );

        // CENA 03: Placa NFC steps softly out of focus, Cartão NFC enters, screen shows real Bio Site
        tl.to(
          '.alf-stage-plaque',
          { x: -24, y: 12, scale: 0.88, opacity: 0.32, duration: 1, ease: 'power2.inOut' },
          'scene3'
        )
          .to(
            '.alf-stage-nfc-pulse',
            { opacity: 0, scale: 1.35, duration: 0.5 },
            'scene3'
          )
          .fromTo(
            '.alf-stage-card',
            { opacity: 0, y: 28, scale: 0.92 },
            { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: 'power2.out' },
            'scene3+=0.1'
          )
          .to(
            '.alf-stage-phone',
            { x: 0, y: 0, scale: 1.05, duration: 1, ease: 'power2.inOut' },
            'scene3'
          )
          .to(
            '.alf-screen-scene2',
            { opacity: 0, duration: 0.4, ease: 'power1.out' },
            'scene3+=0.15'
          )
          .fromTo(
            '.alf-screen-scene3',
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' },
            'scene3+=0.25'
          );

        // CENA 04: Final conversion composition — both solutions visible in harmony
        tl.to(
          '.alf-stage-plaque',
          { x: 0, y: 0, scale: 0.96, opacity: 1, duration: 0.9, ease: 'power2.out' },
          'scene4'
        )
          .to(
            '.alf-stage-phone',
            { scale: 1, duration: 0.9, ease: 'power2.out' },
            'scene4'
          )
          .fromTo(
            '.alf-stage-final-cta',
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' },
            'scene4+=0.2'
          );
      });

      // Mobile — Lightweight entrance, no prolonged pinning
      mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
        gsap.fromTo(
          '.alf-hero-intro',
          { opacity: 0, y: 14 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.06, ease: 'power2.out' }
        );
      });
    }, rootRef);

    const handleResize = () => {
      ScrollTrigger.refresh();
    };
    window.addEventListener('resize', handleResize);

    return () => {
      window.removeEventListener('resize', handleResize);
      ctx.revert();
    };
  }, []);

  return (
    <div ref={rootRef} className="alf-lp-root min-h-screen">
      {/* Barra de retorno caso o administrador já esteja autenticado */}
      {isAdminAuthenticated && onGoToAdminPanel && (
        <div className="bg-[#070B14] border-b border-white/10 py-2 px-4 text-xs text-slate-300">
          <div className="alf-lp-container flex items-center justify-between gap-4">
            <span className="flex items-center gap-2 font-medium truncate">
              <span className="w-2 h-2 rounded-full bg-emerald-400 shrink-0" />
              <span className="truncate">Sessão administrativa ativa</span>
            </span>
            <button
              type="button"
              onClick={onGoToAdminPanel}
              className="text-white hover:text-blue-400 font-semibold flex items-center gap-1 cursor-pointer transition shrink-0"
            >
              <span>Voltar ao Console</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      )}

      {/* HEADER EXECUTIVO FIXO — LOGO PROEMINENTE E RESPONSIVO NO MOBILE E DESKTOP */}
      <header className={`alf-lp-header ${isHeaderScrolled ? 'is-scrolled' : ''}`}>
        <div className="alf-lp-container h-full flex items-center justify-between gap-3 sm:gap-6">
          <a href="#" className="alf-lp-brand-lockup shrink-0">
            <div className="alf-lp-brand-emblem">
              <img
                src="/alf-logo.jpg"
                alt="ALF Automação"
                className="w-full h-full object-contain scale-105"
              />
            </div>
            <div className="text-left leading-none pr-1">
              <div className="flex items-center gap-1.5">
                <span className="font-extrabold text-white text-sm sm:text-base tracking-tight uppercase">
                  ALF
                </span>
                <span className="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-blue-500 text-sm sm:text-base tracking-tight uppercase">
                  AUTOMAÇÃO
                </span>
              </div>
              <div className="flex items-center gap-1.5 mt-1">
                <span className="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0" />
                <span className="text-[9px] sm:text-[10px] font-semibold tracking-[0.12em] text-slate-300 uppercase block">
                  Identidade Digital &amp; NFC
                </span>
              </div>
            </div>
          </a>

          <nav className="hidden lg:flex items-center gap-8 text-sm font-medium text-slate-300">
            <a href="#solucoes" className="hover:text-white transition-colors">
              Soluções
            </a>
            <a href="#modelos" className="hover:text-white transition-colors">
              Bio Sites
            </a>
            <a href="#como-funciona" className="hover:text-white transition-colors">
              Como funciona
            </a>
            <a href="#credibilidade" className="hover:text-white transition-colors">
              Credibilidade
            </a>
          </nav>

          <div className="flex items-center gap-2 sm:gap-3 shrink-0">
            <a
              href="#solucoes"
              className="hidden sm:inline-flex alf-lp-btn-blue text-xs sm:text-sm !py-2.5 !px-4 sm:!px-5"
            >
              <span>Conhecer soluções</span>
            </a>

            <button
              type="button"
              onClick={() => setIsMobileMenuOpen((prev) => !prev)}
              className="lg:hidden w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-white flex items-center justify-center cursor-pointer transition"
              aria-label={isMobileMenuOpen ? 'Fechar menu' : 'Abrir menu'}
            >
              {isMobileMenuOpen ? <X className="w-5 h-5" /> : <Menu className="w-5 h-5" />}
            </button>
          </div>
        </div>

        {/* Menu Mobile */}
        {isMobileMenuOpen && (
          <div className="lg:hidden bg-[#0B1220]/98 backdrop-blur-xl border-b border-white/15 px-5 py-5 space-y-4 shadow-2xl">
            <nav className="flex flex-col space-y-2.5 text-sm font-medium text-slate-200">
              <a
                href="#solucoes"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-2 px-3 rounded-lg hover:bg-white/5 hover:text-white transition-colors"
              >
                Soluções
              </a>
              <a
                href="#modelos"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-2 px-3 rounded-lg hover:bg-white/5 hover:text-white transition-colors"
              >
                Bio Sites
              </a>
              <a
                href="#como-funciona"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-2 px-3 rounded-lg hover:bg-white/5 hover:text-white transition-colors"
              >
                Como funciona
              </a>
              <a
                href="#credibilidade"
                onClick={() => setIsMobileMenuOpen(false)}
                className="py-2 px-3 rounded-lg hover:bg-white/5 hover:text-white transition-colors"
              >
                Credibilidade
              </a>
            </nav>
            <div className="pt-3 border-t border-white/10 flex flex-col gap-2.5">
              <a
                href="#solucoes"
                onClick={() => setIsMobileMenuOpen(false)}
                className="alf-lp-btn-blue w-full"
              >
                <span>Conhecer soluções</span>
              </a>
              <a
                href="#modelos"
                onClick={() => setIsMobileMenuOpen(false)}
                className="alf-lp-btn-ghost-dark w-full"
              >
                <span>Explorar Bio Sites</span>
              </a>
            </div>
          </div>
        )}
      </header>

      {/* ======================================================================
          SEÇÃO 01 — HERO GSAP (DO TOQUE À PRESENÇA DIGITAL)
         ====================================================================== */}
      <section
        ref={heroSectionRef}
        className="alf-lp-hero-bg relative min-h-[calc(100vh-76px)] flex items-center py-8 sm:py-12 lg:py-16 overflow-hidden"
      >
        <div className="alf-lp-container w-full">
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            {/* Coluna Esquerda: Headline Editorial com Destaque Sutil + CTAs Visíveis Imediatamente */}
            <div className="lg:col-span-6 space-y-5 sm:space-y-6 text-left">
              <div className="alf-hero-intro inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/25 shadow-sm">
                <span className="w-2 h-2 rounded-full bg-blue-400 animate-pulse" />
                <span className="alf-lp-kicker text-blue-200">
                  DO TOQUE À PRESENÇA DIGITAL
                </span>
              </div>

              <div className="alf-hero-intro space-y-3">
                <h1 className="alf-lp-h1 text-white">
                  Seu negócio merece{' '}
                  <span className="alf-lp-hero-highlight">
                    ser encontrado. E lembrado.
                  </span>
                </h1>
                <div className="h-1 w-24 rounded-full bg-gradient-to-r from-blue-500 via-sky-400 to-transparent opacity-85" />
              </div>

              <p className="alf-hero-intro text-sm sm:text-lg text-slate-300 max-w-xl leading-relaxed">
                Facilite avaliações no Google e apresente sua empresa com uma presença digital profissional.
              </p>

              {/* CTAs visíveis imediatamente sem depender da animação */}
              <div className="alf-hero-intro pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <a href="#solucoes" className="alf-lp-btn-blue w-full sm:w-auto">
                  <span>Conhecer soluções</span>
                  <ArrowRight className="w-4 h-4" />
                </a>

                <a href="#modelos" className="alf-lp-btn-ghost-dark w-full sm:w-auto">
                  <span>Explorar Bio Sites</span>
                </a>
              </div>

              {/* Indicador Narrativo das 4 Cenas (sincronizado ao scroll e clicável em qualquer tela) */}
              <div className="alf-hero-intro pt-5 border-t border-white/10 space-y-3">
                <div className="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2">
                  {[
                    { id: 1, label: '01. Presença' },
                    { id: 2, label: '02. Placa NFC' },
                    { id: 3, label: '03. Bio Site' },
                    { id: 4, label: '04. Soluções' }
                  ].map((s) => (
                    <button
                      key={s.id}
                      type="button"
                      onClick={() => setActiveScene(s.id as 1 | 2 | 3 | 4)}
                      className={`px-3 py-2 sm:py-1.5 rounded-lg text-xs font-medium transition cursor-pointer text-center ${
                        activeScene === s.id
                          ? 'bg-[#2563EB] text-white shadow-sm shadow-blue-500/30'
                          : 'bg-white/[0.05] text-slate-300 hover:bg-white/10'
                      }`}
                    >
                      {s.label}
                    </button>
                  ))}
                </div>

                {/* Texto narrativo correspondente à cena ativa */}
                <div className="min-h-[56px] flex flex-col justify-center">
                  {activeScene === 1 && (
                    <p className="text-xs sm:text-sm text-slate-300">
                      Conectamos o atendimento presencial da sua empresa à sua reputação e apresentação online.
                    </p>
                  )}
                  {activeScene === 2 && (
                    <div className="space-y-1">
                      <span className="text-xs font-semibold text-blue-400 block">
                        Placa NFC Google — R$ 129
                      </span>
                      <p className="text-xs sm:text-sm text-white font-medium">
                        &ldquo;Um toque. Um caminho mais fácil para receber avaliações.&rdquo;
                      </p>
                    </div>
                  )}
                  {activeScene === 3 && (
                    <div className="space-y-1">
                      <span className="text-xs font-semibold text-blue-400 block">
                        Bio Site + Cartão NFC — R$ 1.199
                      </span>
                      <p className="text-xs sm:text-sm text-white font-medium">
                        &ldquo;Sua apresentação profissional, pronta para compartilhar.&rdquo;
                      </p>
                    </div>
                  )}
                  {activeScene === 4 && (
                    <div className="flex flex-wrap items-center gap-2.5 pt-1">
                      <button
                        type="button"
                        onClick={() => openInterestModal('Placa NFC Google (R$ 129,00)')}
                        className="text-xs font-semibold px-3.5 py-2 rounded-lg bg-white text-[#101D32] hover:bg-slate-100 transition cursor-pointer"
                      >
                        Quero minha placa NFC
                      </button>
                      <a
                        href="#modelos"
                        className="text-xs font-semibold px-3.5 py-2 rounded-lg bg-[#2563EB] text-white hover:bg-[#1D4ED8] transition"
                      >
                        Ver modelos de Bio Site
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* Coluna Direita: Palco Visual GSAP (Placa NFC Real + Cartão NFC + Smartphone Fiel com 3 Opções) */}
            <div className="lg:col-span-6">
              <div className="rounded-3xl bg-[#101D32]/90 border border-white/10 p-4 sm:p-7 shadow-2xl relative overflow-hidden">
                {/* Barra de Identificação do Produto em Foco */}
                <div className="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-white/10">
                  <div className="flex items-center gap-2">
                    <span className="w-2 h-2 rounded-full bg-blue-400" />
                    <span className="text-xs font-semibold text-white">
                      {activeScene === 2
                        ? 'Placa NFC Google — R$ 129'
                        : activeScene === 3
                        ? 'Bio Site + Cartão NFC — R$ 1.199'
                        : 'Soluções Físicas & Digitais ALF'}
                    </span>
                  </div>
                  <span className="text-[11px] text-slate-400">
                    {prefersReducedMotion ? 'Modo estático ativo' : 'Aproximação NFC & QR Code'}
                  </span>
                </div>

                {/* Palco de Composição dos Produtos */}
                <div className="mt-5 grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-5 items-center">
                  {/* Coluna Hardware Físico: Placa NFC Google & Cartão NFC */}
                  <div className="sm:col-span-5 grid grid-cols-1 sm:flex sm:flex-col gap-3.5 relative">
                    {/* Pulso Discreto de Interação NFC (Cena 02) */}
                    <div
                      className={`alf-stage-nfc-pulse alf-gsap-layer pointer-events-none hidden sm:block absolute -right-3 top-12 w-24 h-24 rounded-full border-2 border-[#2563EB]/60 transition-opacity duration-300 ${
                        activeScene === 2 ? 'opacity-100' : 'opacity-0'
                      }`}
                    />

                    {/* Placa NFC Google Realista */}
                    <div
                      onClick={() => setActiveScene(2)}
                      className={`alf-stage-plaque alf-gsap-layer rounded-2xl bg-[#0B1220] border p-3.5 sm:p-4 space-y-2.5 cursor-pointer transition ${
                        activeScene === 2 || activeScene === 1 || activeScene === 4
                          ? 'border-[#2563EB]/70 shadow-lg shadow-blue-950/30 opacity-100'
                          : 'border-white/10 opacity-65'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <div className="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-white/[0.06] border border-white/10">
                          <img
                            src="/alf-logo.jpg"
                            alt="ALF Automação"
                            className="w-5 h-3.5 object-contain"
