                                    : 'text-slate-300 hover:text-white hover:bg-white/5'
                                }`}
                              >
                                {tab.label}
                              </button>
                            );
                          })}
                        </div>
                      </div>

                      {/* Tela Cena 02: Representação fiel do acesso à avaliação no Google */}
                      {activeScene === 2 ? (
                        <div className="alf-screen-scene2 my-auto py-4 space-y-3 text-left">
                          <div className="rounded-2xl bg-white text-[#172033] p-4 space-y-3 shadow-sm">
                            <div className="flex items-center gap-3">
                              <div className="w-9 h-9 rounded-lg bg-[#FAF9F6] border border-[#E5E7EB] p-1.5 flex items-center justify-center shrink-0">
                                <svg viewBox="0 0 24 24" className="w-full h-full">
                                  <path
                                    fill="#4285F4"
                                    d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.665-5.17 3.665-9.12z"
