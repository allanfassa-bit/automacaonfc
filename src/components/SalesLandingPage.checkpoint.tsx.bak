                  <div>
                    <strong className="text-xs font-black text-white block line-clamp-1 leading-snug">
                      {tmpl.category}
                    </strong>
                    <span className="text-[10px] text-cyan-300/90 font-semibold block line-clamp-1 mt-0.5">
                      {tmpl.badge}
                    </span>
                  </div>
                </button>
