                  <div className="flex items-center justify-between">
                    <span className="text-xl">{tmpl.emoji}</span>
                    {isActive ? (
                      <span className="text-[9px] font-black text-emerald-400 bg-emerald-950/80 px-2 py-0.5 rounded-full border border-emerald-500/30">● Em Exibição</span>
