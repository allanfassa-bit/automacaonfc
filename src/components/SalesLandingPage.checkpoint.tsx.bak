import React, { useState, useMemo, useEffect, useRef } from 'react';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);
import {
  Smartphone,
  Star,
  QrCode,
  Globe,
  Zap,
  Shield,
  TrendingUp,
  CheckCircle2,
  Lock,
  ArrowRight,
  Sparkles,
  MapPin,
  ExternalLink,
  MessageCircle,
  Instagram,
  Wifi,
  ChevronRight,
  Award,
  Users,
  BarChart3,
  Flame,
  Check,
  Palette,
  Camera,
  Layers,
  Sparkle,
  Copy,
  Play,
  Eye,
  Radio,
  X
} from 'lucide-react';
import { detectNicheVisualProfile, NicheVisualProfile } from '../utils/nicheVisualDatabase';
import { ALF_LOGO_DATA_URI, READY_MINISITE_MOCKUPS, ReadyMockupTemplate } from '../utils/readyMiniSiteMockups';
import { MiniSiteViewer } from './MiniSiteViewer';

interface InterestLeadPayload {
  name: string;
  email: string;
  phone: string;
  companyName: string;
  niche: string;
  interestType: string;
}

interface SalesLandingPageProps {
  onOpenLogin: (suggestedTab?: string) => void;
  onExploreDemo?: () => void;
  initialNiche?: string;
  onRegisterInterest?: (payload: InterestLeadPayload) => Promise<void> | void;
  isAdminAuthenticated?: boolean;
  onGoToAdminPanel?: () => void;
}

const NICHE_PREVIEWS = [
  { id: 'medica', label: 'Médico & Clínica', icon: '🩺', badge: 'Clean & Sofisticado', mockupId: 'bio_medica' },
  { id: 'corretor_demo', label: 'Corretor de Imóveis', icon: '🏢', badge: 'Imóveis Alto Padrão', mockupId: 'modelo_corretor_demo' },
  { id: 'bio_pessoal_demo', label: 'Bio Pessoal & Executivo', icon: '👔', badge: 'Cartão NFC & vCard', mockupId: 'modelo_bio_pessoal_demo' },
  { id: 'cafe', label: 'Cafeteria & Bistrô', icon: '☕', badge: 'Cardápio & Pedidos', mockupId: 'cafe' },
  { id: 'estetica', label: 'Estética & Skincare', icon: '✨', badge: 'Luxo & GSAP', mockupId: 'bio_estetica_facial' },
  { id: 'gastronomia', label: 'Restaurante & Hamburgueria', icon: '🍔', badge: 'Cardápio 4K', mockupId: 'hamburgueria' },
];

const SHOWCASE_PUBLIC_MODEL_IDS = [
  'bio_medica',
  'modelo_corretor_demo',
  'modelo_bio_pessoal_demo',
  'cafe',
  'bio_estetica_facial',
  'hamburgueria',
];

export const SalesLandingPage: React.FC<SalesLandingPageProps> = ({
  onOpenLogin,
  onExploreDemo,
  initialNiche,
  onRegisterInterest,
  isAdminAuthenticated,
  onGoToAdminPanel
}) => {
  const [dailyClients, setDailyClients] = useState<number>(30);
  const [activeTechTab, setActiveTechTab] = useState<'nfc' | 'qr' | 'social' | 'sites'>('sites');
  const [selectedShowcaseMockupId, setSelectedShowcaseMockupId] = useState<string>('bio_medica');
  const [fullscreenEmulationMockup, setFullscreenEmulationMockup] = useState<ReadyMockupTemplate | null>(null);
  const [isHeaderScrolled, setIsHeaderScrolled] = useState(false);
  const [isPastInitialViewport, setIsPastInitialViewport] = useState(false);
  const [scrollProgress, setScrollProgress] = useState<number>(0);
  const [isNfcTapSimulating, setIsNfcTapSimulating] = useState(false);
  const [logoTilt, setLogoTilt] = useState<{ rx: number; ry: number }>({ rx: 0, ry: 0 });
  const [isPrivacyModalOpen, setIsPrivacyModalOpen] = useState(false);
  const [isDemoModalOpen, setIsDemoModalOpen] = useState(false);
  const [demoModalFilter, setDemoModalFilter] = useState<'all' | 'minisite' | 'nfc' | 'cardapio' | 'card'>('all');
  const landingRef = useRef<HTMLDivElement | null>(null);

  // Public Interest Capture Modal State (replaces public login/password screen to prevent brute-force & account enumeration)
  const [isInterestModalOpen, setIsInterestModalOpen] = useState(false);
  const [interestTopic, setInterestTopic] = useState<string>('Combo Placa NFC + Mini Site Premium');
  const [interestName, setInterestName] = useState('');
  const [interestEmail, setInterestEmail] = useState('');
  const [interestPhone, setInterestPhone] = useState('');
  const [interestCompany, setInterestCompany] = useState('');
  const [interestNicheInput, setInterestNicheInput] = useState('Estética / Clínica Médica');
  const [honeypotWebsite, setHoneypotWebsite] = useState(''); // Anti-bot hidden trap
  const [isSubmittingInterest, setIsSubmittingInterest] = useState(false);
  const [interestSubmittedSuccess, setInterestSubmittedSuccess] = useState(false);
  const [interestError, setInterestError] = useState('');
  const [lastSubmitTimestamp, setLastSubmitTimestamp] = useState<number>(0);
  const secretLogoClicksRef = useRef<{ count: number; lastClick: number }>({ count: 0, lastClick: 0 });

  const openInterestModal = (topic?: string) => {
    if (topic) setInterestTopic(topic);
    setInterestSubmittedSuccess(false);
    setInterestError('');
    setIsInterestModalOpen(true);
  };

  const handleSecretFooterLogoClick = () => {
    const now = Date.now();
    if (now - secretLogoClicksRef.current.lastClick > 2500) {
      secretLogoClicksRef.current.count = 1;
    } else {
      secretLogoClicksRef.current.count += 1;
    }
    secretLogoClicksRef.current.lastClick = now;
    if (secretLogoClicksRef.current.count >= 5) {
      secretLogoClicksRef.current.count = 0;
      onOpenLogin();
    }
  };

  const handleInterestSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setInterestError('');

    // 1. Anti-bot Honeypot check
    if (honeypotWebsite.trim().length > 0) {
      setInterestSubmittedSuccess(true);
      return;
    }

    // 2. Rate limiting (cooldown of 30s between submissions)
    const now = Date.now();
    if (now - lastSubmitTimestamp < 30000) {
      setInterestError('Aguarde alguns segundos antes de enviar uma nova solicitação.');
      return;
    }

    const cleanName = interestName.trim();
    const cleanEmail = interestEmail.trim().toLowerCase();
    const cleanPhone = interestPhone.replace(/\D/g, '');
    const cleanCompany = interestCompany.trim() || cleanName;

    if (!cleanName || cleanName.length < 2) {
      setInterestError('Por favor, informe seu nome.');
      return;
    }
    if (!cleanEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      setInterestError('Por favor, informe um e-mail válido para contato.');
      return;
    }
    if (!cleanPhone || cleanPhone.length < 10) {
      setInterestError('Por favor, informe seu WhatsApp ou telefone com DDD.');
      return;
    }

    setIsSubmittingInterest(true);
    try {
      if (onRegisterInterest) {
        await onRegisterInterest({
          name: cleanName,
          email: cleanEmail,
          phone: cleanPhone,
          companyName: cleanCompany,
          niche: interestNicheInput.trim() || 'Geral',
          interestType: interestTopic
        });
      }
      setLastSubmitTimestamp(Date.now());
      setInterestSubmittedSuccess(true);
    } catch (_) {
      setInterestSubmittedSuccess(true);
    } finally {
      setIsSubmittingInterest(false);
    }
  };

  const selectedShowcaseMockup: ReadyMockupTemplate = useMemo(() => {
    return (
      READY_MINISITE_MOCKUPS.find((m) => m.id === selectedShowcaseMockupId) ||
      READY_MINISITE_MOCKUPS[0]
    );
  }, [selectedShowcaseMockupId]);

  useEffect(() => {
    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      const vh = window.innerHeight || 720;
      const docHeight = Math.max(
        1,
        (document.documentElement.scrollHeight || 2000) - vh
      );
      setIsHeaderScrolled(y > 24);
      setIsPastInitialViewport(y > Math.min(vh * 0.42, 320));
      setScrollProgress(Math.min(100, Math.max(0, (y / docHeight) * 100)));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  useEffect(() => {
    if (!landingRef.current) return;
    const ctx = gsap.context(() => {
      // 1. Hero entrance stagger
      gsap.fromTo(
        '.gsap-landing-hero',
        { opacity: 0, y: 32, scale: 0.98 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.9,
          stagger: 0.12,
          ease: 'power3.out'
        }
      );

      // 2. Continuous ambient motion for ALF Logo Core & NFC rings
      gsap.to('.gsap-alf-logo-float', {
        y: -8,
        duration: 2.4,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut'
      });
      gsap.to('.gsap-orbit-ring-slow', {
        rotation: 360,
        duration: 22,
        repeat: -1,
        ease: 'none'
      });
      gsap.to('.gsap-orbit-ring-reverse', {
        rotation: -360,
        duration: 16,
        repeat: -1,
        ease: 'none'
      });
      gsap.to('.gsap-nfc-wave', {
        scale: 1.38,
        opacity: 0,
        duration: 2.1,
        stagger: 0.65,
        repeat: -1,
        ease: 'power2.out'
      });

      // 3. ScrollTrigger entrance animations for each major section
      gsap.utils.toArray<HTMLElement>('.gsap-scroll-reveal').forEach((sectionEl) => {
        gsap.fromTo(
          sectionEl,
          { opacity: 0, y: 44 },
          {
            opacity: 1,
            y: 0,
            duration: 0.85,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: sectionEl,
              start: 'top 86%',
              toggleActions: 'play none none none'
            }
          }
        );

        const cards = sectionEl.querySelectorAll('.gsap-scroll-card');
        if (cards.length > 0) {
          gsap.fromTo(
            cards,
            { opacity: 0, y: 28, scale: 0.96 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.68,
              stagger: 0.1,
              ease: 'back.out(1.25)',
              scrollTrigger: {
                trigger: sectionEl,
                start: 'top 80%',
                toggleActions: 'play none none none'
              }
            }
          );
        }
      });

      // 4. ScrollTrigger entrance + subtle pulse for all Call-To-Action (CTA) buttons
      gsap.utils.toArray<HTMLElement>('.gsap-cta-btn').forEach((btnEl, idx) => {
        gsap.fromTo(
          btnEl,
          { opacity: 0, y: 20, scale: 0.93 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.65,
            delay: (idx % 3) * 0.06,
            ease: 'back.out(1.6)',
            scrollTrigger: {
              trigger: btnEl,
              start: 'top 92%',
              toggleActions: 'play none none none'
            }
          }
        );
      });
    }, landingRef);

    // Interactive GSAP magnetic hover micro-animations on CTA buttons
    const ctaButtons = Array.from(
      landingRef.current.querySelectorAll<HTMLElement>('.gsap-cta-btn')
    );
    const enterHandlers = new Map<HTMLElement, () => void>();
    const leaveHandlers = new Map<HTMLElement, () => void>();

    ctaButtons.forEach((btn) => {
      const onEnter = () => {
        gsap.to(btn, {
          scale: 1.035,
          y: -2,
          duration: 0.25,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      };
      const onLeave = () => {
        gsap.to(btn, {
          scale: 1,
          y: 0,
          duration: 0.3,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      };
      enterHandlers.set(btn, onEnter);
      leaveHandlers.set(btn, onLeave);
      btn.addEventListener('mouseenter', onEnter);
      btn.addEventListener('mouseleave', onLeave);
    });

    return () => {
      ctaButtons.forEach((btn) => {
        const onEnter = enterHandlers.get(btn);
        const onLeave = leaveHandlers.get(btn);
        if (onEnter) btn.removeEventListener('mouseenter', onEnter);
        if (onLeave) btn.removeEventListener('mouseleave', onLeave);
      });
      ctx.revert();
    };
  }, []);

  const triggerLiveNfcTapSimulation = () => {
    setIsNfcTapSimulating(true);
    setTimeout(() => setIsNfcTapSimulating(false), 3200);
  };

  // Niche visual profile state - allows dynamic testing of any client segment
  const [activeNiche, setActiveNiche] = useState<string>(() => {
    if (initialNiche) return initialNiche;
    try {
      const params = new URLSearchParams(window.location.search);
      const paramNiche = params.get('niche') || params.get('nicho') || params.get('segmento');
      if (paramNiche) return paramNiche;
    } catch (_) {}
    return 'estetica';
  });

  const [activeGalleryIndex, setActiveGalleryIndex] = useState<number>(0);

  // Dynamic visual assets loaded from the specialized niche database
  const visualProfile: NicheVisualProfile = useMemo(() => {
    return detectNicheVisualProfile(activeNiche);
  }, [activeNiche]);

  const { visual_assets } = visualProfile;
  const { palette, image_prompts, animation_style } = visual_assets;

  // Interactive ROI calculation
  const estimatedMonthlyReviews = Math.round(dailyClients * 0.2 * 30);
  const estimatedNewCustomers = Math.round(dailyClients * 0.35 * 30);
  const estimatedRevenueGain = estimatedNewCustomers * 45; // ticket médio R$ 45

  // Animation class based on the detected animation style
  const getAnimationClass = () => {
    switch (animation_style) {
      case 'premium_fade':
        return 'transition-all duration-700 ease-out animate-in fade-in';
      case 'dynamic_slide':
        return 'transition-all duration-500 ease-out animate-in slide-in-from-bottom-6 fade-in';
      case 'smooth_reveal':
        return 'transition-all duration-500 ease-out animate-in zoom-in-95 fade-in';
      case 'energetic_pop':
        return 'transition-all duration-300 ease-out animate-in zoom-in-90 fade-in';
      default:
        return 'transition-all duration-500 ease-out animate-in fade-in';
    }
  };

  return (
    <div ref={landingRef} className="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-cyan-500 selection:text-slate-950 antialiased overflow-x-hidden">
      
      {/* Top Navbar with Clean 3-Zone Architecture */}
      <header
        className={`sticky top-0 z-50 transition-all duration-300 ease-out ${
          isPastInitialViewport
            ? 'bg-slate-950/95 backdrop-blur-2xl border-b border-cyan-400/30 shadow-xl shadow-cyan-950/40 py-2'
            : isHeaderScrolled
            ? 'bg-slate-950/90 backdrop-blur-xl border-b border-slate-800 shadow-md py-2.5'
            : 'bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 py-3'
        }`}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-6">
          {/* Zone 1: Brand Wordmark */}
          <div className="flex items-center gap-3 shrink-0">
            <div className="h-10 w-28 sm:w-32 rounded-xl bg-black/90 border border-white/10 overflow-hidden flex items-center justify-center p-1 shadow-md shadow-cyan-950/20">
              <img
                src="/alf-logo.jpg"
                alt="ALF Automation"
                className="w-full h-full object-contain"
              />
            </div>
            <div className="hidden sm:block text-left">
              <span className="font-black text-white text-sm tracking-tight block leading-none font-display">
                ALF AUTOMATION
              </span>
              <span className="text-[9.5px] text-slate-400 font-mono tracking-wider block mt-1 uppercase">
                HARDWARE NFC &amp; BIO SITES
              </span>
            </div>
          </div>

          {/* Zone 2: Navigation Links */}
          <nav className="hidden lg:flex items-center gap-7 text-xs font-semibold text-slate-300">
            <a href="#demonstracao-modelos" className="hover:text-cyan-400 transition-colors whitespace-nowrap">Modelos Prontos</a>
            <a href="#prova-social" className="hover:text-cyan-400 transition-colors whitespace-nowrap">Por Que Ter &amp; Prova Social</a>
            <a href="#solucoes" className="hover:text-cyan-400 transition-colors whitespace-nowrap">Tecnologia NFC</a>
            <a href="#precos" className="hover:text-cyan-400 transition-colors whitespace-nowrap">Soluções &amp; Orçamento</a>
            <a href="https://wa.me/5514981304973" target="_blank" rel="noreferrer" className="text-emerald-400 hover:text-emerald-300 transition-colors whitespace-nowrap">WhatsApp</a>
          </nav>

          {/* Zone 3: Actions Cluster with VEJA UMA DEMO button */}
          <div className="flex items-center gap-2.5 shrink-0">
            <button
              type="button"
              onClick={() => setIsDemoModalOpen(true)}
              className="bg-cyan-400 hover:bg-cyan-300 text-slate-950 text-xs font-black py-2.5 px-4 rounded-xl flex items-center gap-2 transition-all shadow-lg shadow-cyan-400/20 active:scale-95 cursor-pointer whitespace-nowrap"
            >
              <Play className="w-3.5 h-3.5 fill-current text-slate-950" />
              <span>Veja uma demo</span>
            </button>
          </div>
        </div>

        {/* Scroll Progress Line */}
        <div className="w-full h-[1.5px] bg-slate-900 overflow-hidden mt-2">
          <div
            className="h-full bg-gradient-to-r from-cyan-400 via-blue-500 to-amber-400 transition-all duration-150 ease-out"
            style={{ width: `${scrollProgress}%` }}
          />
        </div>
      </header>

      {/* HERO SECTION */}
      <section className="relative pt-16 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
        {/* Subtle high-tech ambient glows */}
        <div className="absolute top-12 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-gradient-to-b from-cyan-500/10 via-blue-500/5 to-transparent blur-3xl pointer-events-none" />
        
        {/* Unboxed clean metadata kicker */}
        <div className="flex items-center justify-center gap-2 text-xs font-semibold text-slate-400 mb-6">
          <span className="text-cyan-400 font-mono font-bold tracking-wider">ALF AUTOMATION</span>
          <span aria-hidden="true" className="text-slate-600">·</span>
          <span>Sistemas NFC &amp; Mini Sites em Nuvem</span>
          <span aria-hidden="true" className="text-slate-600">·</span>
          <span className="text-slate-300">Edição 2026</span>
        </div>

        {/* High-impact headline */}
        <h1 className="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight max-w-4xl mx-auto leading-[1.1] text-balance">
          Transforme Quem Visita Sua Empresa em{' '}
          <span className="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-sky-300 to-amber-300">
            Avaliações 5★ no Google
          </span>{' '}
          e Vendas no WhatsApp em 3 Segundos
        </h1>

        {/* High-legibility value proposition */}
        <p className="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Placas Acrílicas NFC Inteligentes, QR Codes Dinâmicos e Mini Sites de Apresentação de Alta Conversão. Sem digitar links, sem baixar aplicativos e com redirecionamento dinâmico em nuvem.
        </p>

        {/* Hero CTAs - Led by VEJA UMA DEMO */}
        <div className="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-lg mx-auto">
          <button
            type="button"
            onClick={() => setIsDemoModalOpen(true)}
            className="gsap-cta-btn w-full sm:w-auto bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-black px-7 py-3.5 rounded-2xl flex items-center justify-center gap-2.5 shadow-xl shadow-cyan-400/20 transition-all active:scale-95 cursor-pointer text-sm"
          >
            <Play className="w-4 h-4 fill-current text-slate-950" />
            <span>Veja uma demo</span>
          </button>
          
          <a
            href="https://wa.me/5514981304973?text=Ol%C3%A1!%20Gostaria%20de%20ver%20uma%20demonstra%C3%A7%C3%A3o%20das%20Placas%20NFC%20e%20Mini%20Sites."
            target="_blank"
            rel="noopener noreferrer"
            className="gsap-cta-btn w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-3.5 rounded-2xl border border-slate-700 flex items-center justify-center gap-2 transition text-sm cursor-pointer"
          >
            <MessageCircle className="w-4 h-4 text-emerald-400" />
            <span>Falar no WhatsApp</span>
          </a>
        </div>

        {/* Quantitative Rigor Strip */}
        <div className="mt-14 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto text-left">
          <div className="bg-slate-900/60 border border-slate-800 p-4 rounded-2xl">
            <div className="text-2xl font-black text-cyan-400 font-mono tabular-nums">0.3s</div>
            <div className="text-xs font-bold text-white mt-1">Aproximação NFC</div>
            <div className="text-[11px] text-slate-400 mt-0.5">Sem digitar link nem procurar no Google</div>
          </div>
          <div className="bg-slate-900/60 border border-slate-800 p-4 rounded-2xl">
            <div className="text-2xl font-black text-emerald-400 font-mono tabular-nums">+340%</div>
            <div className="text-xs font-bold text-white mt-1">Mais Avaliações 5★</div>
            <div className="text-[11px] text-slate-400 mt-0.5">Empresas saltam para o topo do Google Maps</div>
          </div>
          <div className="bg-slate-900/60 border border-slate-800 p-4 rounded-2xl">
            <div className="text-2xl font-black text-amber-400 font-mono tabular-nums">100%</div>
            <div className="text-xs font-bold text-white mt-1">Nuvem Dinâmica</div>
            <div className="text-[11px] text-slate-400 mt-0.5">Altere o link de destino quando quiser</div>
          </div>
          <div className="bg-slate-900/60 border border-slate-800 p-4 rounded-2xl">
            <div className="text-2xl font-black text-indigo-400 font-mono tabular-nums">Zero App</div>
            <div className="text-xs font-bold text-white mt-1">Compatível iPhone &amp; Android</div>
            <div className="text-[11px] text-slate-400 mt-0.5">Funciona nativamente em qualquer celular</div>
          </div>
        </div>

        {/* ====================================================================
            INTERACTIVE GSAP MOTION SHOWCASE: TOTEM 3D ACRÍLICO NFC + LASER SCANNER
           ==================================================================== */}
        <div
          onMouseMove={(e) => {
            const rect = e.currentTarget.getBoundingClientRect();
            const nx = (e.clientX - rect.left) / rect.width - 0.5;
            const ny = (e.clientY - rect.top) / rect.height - 0.5;
            setLogoTilt({ rx: -ny * 10, ry: nx * 12 });
          }}
          onMouseLeave={() => setLogoTilt({ rx: 0, ry: 0 })}
          className="gsap-landing-hero mt-12 max-w-5xl mx-auto rounded-3xl bg-gradient-to-b from-[#0c101a] via-[#070a12] to-black border border-white/10 p-6 sm:p-10 shadow-2xl shadow-cyan-950/30 relative overflow-hidden text-left"
        >
          {/* Subtle architectural ambient halo */}
          <div className="absolute -top-32 -left-32 w-80 h-80 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" />
          <div className="absolute -bottom-32 -right-32 w-80 h-80 rounded-full bg-amber-500/10 blur-3xl pointer-events-none" />

          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            {/* Left: 3D Acrylic NFC Plaque with Laser Scanner & Radiating Waves */}
            <div className="lg:col-span-5 flex flex-col items-center justify-center">
              <div
                style={{
                  transform: `perspective(900px) rotateX(${logoTilt.rx}deg) rotateY(${logoTilt.ry}deg)`,
                  transition: 'transform 180ms cubic-bezier(0.22, 1, 0.36, 1)'
                }}
                className="relative w-64 h-72 sm:w-72 sm:h-80 flex flex-col items-center justify-center cursor-pointer select-none"
                onClick={triggerLiveNfcTapSimulation}
