                <div className="gsap-nfc-wave absolute w-64 h-64 rounded-full border border-cyan-400/15 pointer-events-none" />

                {/* 3D Physical Cast Acrylic NFC Plaque (10x10cm Format) */}
                <div className="relative w-52 h-64 rounded-2xl bg-gradient-to-b from-[#131926] via-[#0a0d14] to-black border-2 border-white/20 shadow-2xl p-4 flex flex-col items-center justify-between overflow-hidden group">
                  {/* Laser Scanner Beam Motion */}
                  <div className="absolute inset-x-0 h-1 bg-gradient-to-r from-transparent via-cyan-400 to-transparent shadow-[0_0_12px_#22d3ee] animate-laser-sweep pointer-events-none z-20" />

                  {/* Glass Beveled Glare Reflection */}
                  <div className="absolute inset-0 bg-gradient-to-tr from-white/5 via-transparent to-white/10 pointer-events-none" />

                  {/* Top: ALF Titanium Metallic Header */}
                  <div className="w-full relative z-10 flex flex-col items-center">
                    <div className="h-7 w-24 overflow-hidden flex items-center justify-center">
                      <img src="/alf-logo.jpg" alt="ALF Titanium" className="w-full h-full object-contain" />
                    </div>
                    <span className="text-[8px] font-mono tracking-[0.2em] uppercase text-slate-400 mt-1">
                      HARDWARE NFC · CAST ACRYLIC
                    </span>
                  </div>

                  {/* Center: Official Google 5★ Crest (Vector SVG) */}
                  <div className="relative z-10 flex flex-col items-center text-center my-auto py-2">
                    <div className="w-12 h-12 rounded-full bg-white p-2.5 shadow-md flex items-center justify-center mb-1.5">
                      <svg viewBox="0 0 24 24" className="w-full h-full">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.665-5.17 3.665-9.12z" />
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.03c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.13C3.26 21.41 7.33 24 12 24z" />
                        <path fill="#FBBC05" d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.58H1.24C.45 8.15 0 9.97 0 12s.45 3.85 1.24 5.42l4.04-3.13z" />
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.59 1.24 6.58l4.04 3.13c.95-2.83 3.6-4.96 6.72-4.96z" />
                      </svg>
                    </div>

                    <div className="flex items-center gap-1 text-amber-400">
                      {[1, 2, 3, 4, 5].map((s) => (
                        <svg key={s} className="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
