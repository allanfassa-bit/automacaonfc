                  <div className="absolute -right-3 -bottom-4 bg-slate-950/95 border-2 border-emerald-400 rounded-2xl p-3.5 shadow-2xl z-30 text-left w-52 animate-in zoom-in-95 duration-200">
                    <div className="flex items-center gap-1.5 text-[10px] font-black text-emerald-400">
                      <CheckCircle2 className="w-4 h-4" />
                      <span>Conexão NFC em 0.3s!</span>
                    </div>
                    <p className="text-[10.5px] font-bold text-white mt-1 leading-snug">
