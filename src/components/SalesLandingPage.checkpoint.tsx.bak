                    <label className="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1">
                      Seu Nome Completo *
                    </label>
                    <input
                      type="text"
                      required
                      value={interestName}
                      onChange={(e) => setInterestName(e.target.value)}
                      placeholder="Ex: Dra. Camila Andrade"
                      className="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-hidden transition"
                    />
                  </div>

                  <div>
                    <label className="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1">
                      Seu Melhor E-mail *
                    </label>
                    <input
                      type="email"
                      required
                      value={interestEmail}
                      onChange={(e) => setInterestEmail(e.target.value)}
                      placeholder="contato@suaempresa.com.br"
                      className="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-hidden transition"
                    />
                  </div>

                  <div>
                    <label className="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1">
                      Telefone / WhatsApp (com DDD) *
                    </label>
                    <input
                      type="tel"
                      required
                      value={interestPhone}
                      onChange={(e) => setInterestPhone(e.target.value)}
                      placeholder="(14) 99999-9999"
                      className="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-hidden transition"
                    />
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <div>
                      <label className="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1">
                        Nome da Clínica / Empresa
                      </label>
                      <input
                        type="text"
                        value={interestCompany}
                        onChange={(e) => setInterestCompany(e.target.value)}
                        placeholder="Ex: Clínica Lumière"
                        className="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-hidden transition"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] font-bold text-slate-300 uppercase tracking-wider mb-1">
                        Ramo de Atuação
                      </label>
                      <input
                        type="text"
                        value={interestNicheInput}
                        onChange={(e) => setInterestNicheInput(e.target.value)}
                        placeholder="Ex: Estética, Médica..."
                        className="w-full bg-slate-950 border border-slate-700 focus:border-cyan-400 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-hidden transition"
                      />
                    </div>
                  </div>
                </div>

                {interestError && (
                  <div className="p-3 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-200 text-xs font-semibold">
                    {interestError}
                  </div>
                )}

                <button
                  type="submit"
                  disabled={isSubmittingInterest}
                  className="w-full py-3.5 rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-cyan-500/25 transition flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>{isSubmittingInterest ? 'Registrando Interesse...' : 'Enviar E-mail e Telefone de Interesse'}</span>
                </button>

                <p className="text-[10px] text-slate-400 text-center flex items-center justify-center gap-1">
                  <Shield className="w-3 h-3 text-emerald-400" />
                  <span>Seus dados estão protegidos e livres de spam.</span>
                </p>
              </form>
            ) : (
              <div className="text-center space-y-4 py-3">
                <div className="w-14 h-14 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-8 h-8" />
                </div>
                <div className="space-y-1">
                  <span className="text-[10px] font-black uppercase tracking-widest text-emerald-400">
                    Interesse Registrado com Sucesso
                  </span>
                  <h4 className="text-xl font-black text-white">
                    Recebemos seu Contato, {interestName.split(' ')[0]}!
                  </h4>
                  <p className="text-xs text-slate-300 leading-relaxed">
                    Seu e-mail (<strong>{interestEmail}</strong>) e telefone (<strong>{interestPhone}</strong>) foram registrados com prioridade para nossa equipe de especialistas.
                  </p>
                </div>

                <div className="pt-2 space-y-2.5">
                  <a
                    href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                      `Olá ALF Automation! Me chamo ${interestName} (${interestCompany || interestNicheInput}). Acabei de cadastrar meu e-mail (${interestEmail}) e telefone (${interestPhone}) no site com interesse em: ${interestTopic}.`
                    )}`}
                    target="_blank"
                    rel="noreferrer"
                    className="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg transition"
                  >
                    <MessageCircle className="w-4 h-4" />
                    <span>Adiantar Atendimento no WhatsApp Agora</span>
                  </a>

                  <button
                    type="button"
                    onClick={() => setIsInterestModalOpen(false)}
                    className="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs cursor-pointer transition"
                  >
                    Continuar Explorando o Site e os Modelos
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* ======================================================================
          CENTRAL DE DEMONSTRAÇÕES INTERATIVAS (MODAL DE OPÇÕES DE DEMO)
          Atende a exigência: "os paineis de demostração deve ter um botao escrito veja uma demo e aii aparece a opção"
         ====================================================================== */}
      {isDemoModalOpen && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-950/85 backdrop-blur-xl overflow-y-auto animate-in fade-in duration-200"
          onClick={(e) => {
            if (e.target === e.currentTarget) setIsDemoModalOpen(false);
          }}
        >
          <div className="relative w-full max-w-5xl my-auto rounded-3xl bg-slate-900/95 border border-slate-700/80 p-5 sm:p-8 shadow-2xl shadow-cyan-500/10 text-slate-100 space-y-6 max-h-[92vh] overflow-y-auto">
            {/* Header */}
            <div className="flex items-start justify-between gap-4 border-b border-slate-800 pb-5">
              <div className="space-y-1.5 text-left">
                <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-[11px] font-black uppercase tracking-wider">
                  <Play className="w-3 h-3 fill-current" />
                  <span>Central de Demonstrações Interativas • Tecnologia ALF</span>
                </div>
                <h3 className="text-xl sm:text-2xl font-black text-white tracking-tight">
                  Escolha o Modelo ou Solução que Deseja Experimentar
                </h3>
                <p className="text-xs text-slate-400 max-w-2xl leading-relaxed">
                  Selecione uma das opções abaixo para interagir no simulador de celular da página, testar a aproximação NFC em tempo real ou abrir a versão completa em nova aba.
                </p>
              </div>

              <button
                type="button"
                onClick={() => setIsDemoModalOpen(false)}
                className="w-10 h-10 rounded-2xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center border border-slate-700 transition cursor-pointer shrink-0"
                aria-label="Fechar Central de Demonstrações"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Filter Pills */}
            <div className="flex flex-wrap items-center gap-2">
              <button
                type="button"
                onClick={() => setDemoModalFilter('all')}
                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  demoModalFilter === 'all'
                    ? 'bg-cyan-500 text-slate-950 font-black shadow-md shadow-cyan-500/25'
                    : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/60'
                }`}
              >
                Todos os Modelos
              </button>
              <button
                type="button"
                onClick={() => setDemoModalFilter('minisite')}
                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  demoModalFilter === 'minisite'
                    ? 'bg-cyan-500 text-slate-950 font-black shadow-md shadow-cyan-500/25'
                    : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/60'
                }`}
              >
                Mini Sites &amp; Perfis Pessoais
              </button>
              <button
                type="button"
                onClick={() => setDemoModalFilter('nfc')}
                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  demoModalFilter === 'nfc'
                    ? 'bg-cyan-500 text-slate-950 font-black shadow-md shadow-cyan-500/25'
                    : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/60'
                }`}
              >
                Placas NFC 5★ Google
              </button>
              <button
                type="button"
                onClick={() => setDemoModalFilter('cardapio')}
                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  demoModalFilter === 'cardapio'
                    ? 'bg-cyan-500 text-slate-950 font-black shadow-md shadow-cyan-500/25'
                    : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/60'
                }`}
              >
                Cardápio Digital 4K
              </button>
              <button
                type="button"
                onClick={() => setDemoModalFilter('card')}
                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  demoModalFilter === 'card'
                    ? 'bg-cyan-500 text-slate-950 font-black shadow-md shadow-cyan-500/25'
                    : 'bg-slate-800/80 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-700/60'
                }`}
              >
                Cartão NFC Executivo
              </button>
            </div>

            {/* Demos Cards Grid (Generic Models Only - Emulation & Solicitar Modelo, No External Link Copying) */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-left">
              {SHOWCASE_PUBLIC_MODEL_IDS.map((modelId) => {
                const tmpl = READY_MINISITE_MOCKUPS.find((m) => m.id === modelId);
                if (!tmpl) return null;
                const isCardapio = tmpl.id === 'cafe' || tmpl.id === 'hamburgueria';
                const isCard = tmpl.id === 'modelo_bio_pessoal_demo' || tmpl.id === 'modelo_corretor_demo';
                if (demoModalFilter === 'cardapio' && !isCardapio) return null;
                if (demoModalFilter === 'card' && !isCard) return null;
                if (demoModalFilter === 'nfc') return null;

                return (
                  <div
                    key={tmpl.id}
                    className="rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-cyan-500/40 p-4 sm:p-5 flex flex-col justify-between gap-4 shadow-xl transition-all group"
                  >
                    <div className="space-y-2.5">
                      <div className="flex items-center justify-between">
                        <span className="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                          {tmpl.emoji} {tmpl.category}
                        </span>
                        <span className="text-amber-400 text-xs">★★★★★</span>
                      </div>

                      <h4 className="text-base font-black text-white group-hover:text-cyan-300 transition-colors">
                        {tmpl.title}
                      </h4>

                      <p className="text-xs text-slate-300 leading-relaxed bg-slate-950/60 p-2.5 rounded-xl border border-white/5">
                        {tmpl.config.bio}
                      </p>

                      <div className="flex flex-wrap gap-1.5 pt-1">
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">{tmpl.badge}</span>
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">WhatsApp 1-Clique</span>
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">NFC + QR</span>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800">
                      <button
                        type="button"
                        onClick={() => {
                          setSelectedShowcaseMockupId(tmpl.id);
                          setIsDemoModalOpen(false);
                          setFullscreenEmulationMockup(tmpl);
                        }}
                        className="py-2.5 px-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-xs flex items-center justify-center gap-1.5 transition cursor-pointer shadow-md shadow-cyan-500/20"
                      >
                        <Eye className="w-3.5 h-3.5" />
                        <span>Tela Cheia</span>
                      </button>

                      <a
                        href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                          `Olá! Gostei do modelo "${tmpl.category} (${tmpl.title})" e quero solicitar um Mini Site desse modelo!`
                        )}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-300 font-bold text-xs flex items-center justify-center gap-1.5 transition border border-emerald-500/30"
                      >
                        <MessageCircle className="w-3.5 h-3.5" />
                        <span>Solicitar Modelo</span>
                      </a>
                    </div>
                  </div>
                );
              })}

              {/* Placa Acrílica NFC 5★ Google (Physical NFC Hardware) */}
              {(demoModalFilter === 'all' || demoModalFilter === 'nfc') && (
                <div className="rounded-2xl bg-gradient-to-br from-[#090d14] via-[#0b1220] to-[#060910] border-2 border-cyan-500/40 p-4 sm:p-5 flex flex-col justify-between gap-4 shadow-xl relative overflow-hidden group">
                  <div className="space-y-3 relative z-10">
                    <div className="flex items-center justify-between">
                      <span className="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                        Hardware • Aproximação 0.3s
                      </span>
                      <span className="text-cyan-400 text-xs font-mono font-bold">SEM BATERIA</span>
                    </div>

                    <div className="flex items-center gap-3 p-2.5 rounded-xl bg-black/70 border border-cyan-500/30">
                      <div className="w-12 h-14 rounded-lg bg-gradient-to-b from-slate-800 to-black border border-white/20 flex flex-col items-center justify-between p-1 shrink-0 relative overflow-hidden">
                        <div className="absolute inset-x-0 top-1/2 h-0.5 bg-cyan-400 shadow-[0_0_8px_#22d3ee] animate-laser-sweep" />
                        <svg className="w-4 h-4" viewBox="0 0 24 24">
                          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                        </svg>
                        <div className="flex gap-0.5 text-amber-400">
                          <Star className="w-1.5 h-1.5 fill-amber-400" />
                          <Star className="w-1.5 h-1.5 fill-amber-400" />
                          <Star className="w-1.5 h-1.5 fill-amber-400" />
                          <Star className="w-1.5 h-1.5 fill-amber-400" />
                          <Star className="w-1.5 h-1.5 fill-amber-400" />
                        </div>
                        <span className="text-[6.5px] font-mono text-cyan-300 font-bold">NTAG213</span>
                      </div>
                      <div className="min-w-0 flex-1">
                        <h4 className="text-sm font-black text-white group-hover:text-cyan-300 transition-colors flex items-center gap-1.5">
                          <Radio className="w-3.5 h-3.5 text-cyan-400 shrink-0" />
                          Placa Acrílica NFC 5★
                        </h4>
                        <p className="text-[10px] text-slate-400 mt-0.5">Balcão &amp; Mesas • Google Maps Oficial</p>
                      </div>
                    </div>

                    <p className="text-xs text-slate-300 leading-relaxed bg-black/50 p-2.5 rounded-xl border border-white/5">
                      Placa de balcão e mesa em acrílico cristal cortado a laser com chip NTAG213 blindado. O cliente apenas encosta o celular e a avaliação 5 estrelas do Google Maps abre instantaneamente.
                    </p>
                  </div>

                  <div className="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800 relative z-10">
                    <button
                      type="button"
                      onClick={() => {
                        setIsDemoModalOpen(false);
                        triggerLiveNfcTapSimulation();
                      }}
                      className="py-2.5 px-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-xs flex items-center justify-center gap-1.5 transition cursor-pointer shadow-md shadow-cyan-500/20"
                    >
                      <Zap className="w-3.5 h-3.5" />
                      <span>Testar Toque NFC</span>
                    </button>

                    <a
                      href="https://wa.me/5514981304973?text=Ol%C3%A1!%20Gostaria%20de%20solicitar%20a%20Placa%20Acr%C3%ADlica%20NFC%205%20Estrelas%20do%20Google."
                      target="_blank"
                      rel="noopener noreferrer"
                      className="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-cyan-300 font-bold text-xs flex items-center justify-center gap-1.5 transition border border-cyan-500/30 cursor-pointer"
                    >
                      <span>Consultar Placa</span>
                      <ArrowRight className="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              )}
            </div>

            {/* Modal Footer Call to Action */}
            <div className="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 bg-slate-950/50 p-4 rounded-2xl">
              <div className="text-left text-xs text-slate-400">
                <span className="text-white font-bold block">Quer um modelo 100% customizado para a sua marca?</span>
                Personalizamos cores, fotos, botões e entregamos pronto para uso com suporte completo.
              </div>

              <div className="flex items-center gap-2.5 w-full sm:w-auto">
                <a
                  href="https://wa.me/5514981304973?text=Ol%C3%A1!%20Vi%20os%20modelos%20de%20Mini%20Site%20e%20Placas%20NFC%20e%20quero%20um%20or%C3%A7amento%20personalizado."
                  target="_blank"
                  rel="noopener noreferrer"
                  className="w-full sm:w-auto py-2.5 px-5 rounded-xl bg-linear-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 transition shadow-lg shadow-cyan-500/25 cursor-pointer"
                >
                  <MessageCircle className="w-3.5 h-3.5" />
                  <span>Falar com Especialista no WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ======================================================================
          MODAL DE EMULAÇÃO EM TELA CHEIA (SEM COPIAR LINK DA PÁGINA PRINCIPAL)
         ====================================================================== */}
      {fullscreenEmulationMockup && (
        <div
          role="dialog"
          aria-modal="true"
          className="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-2xl flex flex-col overflow-hidden animate-in fade-in duration-200"
        >
          {/* Top Bar of Full-Screen Emulation */}
          <div className="w-full bg-slate-900/95 border-b border-slate-800 px-4 py-3 flex flex-wrap items-center justify-between gap-3 shrink-0 z-20">
            <div className="flex items-center gap-3">
              <span className="text-xl">{fullscreenEmulationMockup.emoji}</span>
              <div className="text-left">
                <div className="flex items-center gap-2">
                  <span className="text-[10px] font-mono font-bold uppercase tracking-wider text-cyan-400 bg-cyan-950/80 px-2 py-0.5 rounded border border-cyan-500/30">
                    Modo Emulação em Tela Cheia
                  </span>
                  <span className="text-[11px] text-slate-400 hidden sm:inline">
                    • {fullscreenEmulationMockup.category}
                  </span>
                </div>
                <strong className="text-xs sm:text-sm font-black text-white block mt-0.5">
                  {fullscreenEmulationMockup.title}
                </strong>
              </div>
            </div>

            {/* Quick Category Switcher inside Full-Screen Emulation */}
            <div className="hidden xl:flex items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800">
              {SHOWCASE_PUBLIC_MODEL_IDS.map((id) => {
                const m = READY_MINISITE_MOCKUPS.find((item) => item.id === id);
                if (!m) return null;
                const active = m.id === fullscreenEmulationMockup.id;
                return (
                  <button
                    key={m.id}
                    type="button"
                    onClick={() => {
                      setFullscreenEmulationMockup(m);
                      setSelectedShowcaseMockupId(m.id);
                    }}
                    className={`px-2.5 py-1.5 rounded-lg text-[11px] font-bold transition cursor-pointer flex items-center gap-1 ${
                      active
                        ? 'bg-cyan-500 text-slate-950 font-black'
                        : 'text-slate-400 hover:text-white hover:bg-slate-900'
                    }`}
                  >
                    <span>{m.emoji}</span>
                    <span>{m.category.split(' ')[0]}</span>
                  </button>
                );
              })}
            </div>

            <div className="flex items-center gap-2.5">
              <a
                href={`https://wa.me/5514981304973?text=${encodeURIComponent(
                  `Olá! Estou visualizando a emulação em tela cheia do modelo "${fullscreenEmulationMockup.category} (${fullscreenEmulationMockup.title})" e quero solicitar um site nesse modelo!`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                className="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs flex items-center gap-1.5 shadow-lg shadow-emerald-500/20 transition"
              >
                <MessageCircle className="w-3.5 h-3.5" />
                <span>Solicitar Site Deste Modelo</span>
              </a>

              <button
                type="button"
                onClick={() => setFullscreenEmulationMockup(null)}
                className="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs flex items-center gap-1.5 border border-slate-700 cursor-pointer transition"
              >
                <X className="w-4 h-4" />
                <span>Fechar Tela Cheia</span>
              </button>
            </div>
          </div>

          {/* Fullscreen Scrollable Emulation Viewport */}
          <div className="flex-1 overflow-y-auto bg-black">
            <MiniSiteViewer
              key={`fullscreen-${fullscreenEmulationMockup.id}`}
              standalone={true}
              config={fullscreenEmulationMockup.config}
              leadId={fullscreenEmulationMockup.id}
            />
          </div>
        </div>
      )}

      {/* Floating WhatsApp Button with ALF Automation Logo */}
      <a
        href="https://wa.me/5514981304973"
        target="_blank"
        rel="noreferrer"
        className="fixed bottom-5 right-5 z-50 flex items-center gap-2.5 bg-slate-950/95 hover:bg-slate-900 border-2 border-emerald-400 text-white pl-2 pr-4 py-2 rounded-2xl shadow-2xl shadow-emerald-500/25 transition-all hover:scale-105"
      >
        <div className="w-11 h-8 rounded-lg bg-black border border-emerald-400/50 overflow-hidden flex items-center justify-center p-0.5">
          <img src={ALF_LOGO_DATA_URI} alt="ALF Automation" className="w-full h-full object-contain" />
        </div>
        <div className="text-left">
          <span className="text-[10px] font-black uppercase tracking-wider text-emerald-400 block leading-none">
            WhatsApp Oficial
          </span>
          <span className="text-xs font-black text-white block">
            ALF Automation
          </span>
        </div>
      </a>

    </div>
  );
};
